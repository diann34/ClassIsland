<controls1:ViewBase x:Class="ClassIsland.Views.SettingsWindowNew"
          xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:ci="http://classisland.tech/schemas/xaml/core"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:local="clr-namespace:ClassIsland.Views"
          xmlns:controls="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
          xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
          xmlns:controls1="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
          xmlns:commands="http://classisland.tech/schemas/xaml/core"
          xmlns:input="clr-namespace:Avalonia.Labs.Input;assembly=Avalonia.Labs.CommandManager"
          xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
          xmlns:windowing="clr-namespace:FluentAvalonia.UI.Windowing;assembly=FluentAvalonia"
          d:DataContext="{d:DesignInstance local:SettingsWindowNew}"
          mc:Ignorable="d"
          Header="{ci:Tr SettingsWindowNew.Header.ApplicationSettings}" HostHeight="550" HostWidth="1240"
          x:Name="SettingsWindowRoot"
          SizeChanged="SettingsWindowNew_OnSizeChanged"
          Closed="ViewBase_OnClosed"
          NavigationPage.HasBackButton="False"
          NavigationPage.BarHeightOverride="48"
          Icon="/Assets/AppLogo.ico">
    <NavigationPage.TopCommandBar>
        <StackPanel Grid.Column="2" Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Spacing="8"
                                DataContext="{Binding #SettingsWindowRoot}">
            <Button Classes="accent"
                    ToolTip.Tip="{ci:Tr SettingsWindowNew.ToolTip.SomeSettingsRequireARestartToTakeEffect}"
                    Margin="0 -8" VerticalAlignment="Center"
                    IsVisible="{Binding ViewModel.IsRequestedRestart}"
                    Click="ButtonRestartApp_OnClick">
                <commands:IconText Glyph="&#xE0BD;" Text="{ci:Tr SettingsWindowNew.Text.RequiresRestart}"/>
            </Button>
            <TextBlock Text="{x:Static commands:AppBase.AppVersion}"
                       VerticalAlignment="Center" ToolTip.Tip="{ci:Tr SettingsWindowNew.ToolTip.AppVersion}"
                       Margin="0 2 0 0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Button Theme="{StaticResource TransparentButton}"
                    ToolTip.Tip="{ci:Tr SettingsWindowNew.ToolTip.MoreOptions}" VerticalAlignment="Center"
                    HorizontalAlignment="Right">
                <commands:FluentIcon Glyph="&#xEBAC;" />
                <Button.Flyout>
                    <MenuFlyout>
                        <MenuItem Icon="{controls:FluentIcon &#xE508;}" Header="{ci:Tr SettingsWindowNew.Header.ExperimentalFunction}"
                                  Click="MenuItemExperimentalSettings_OnClick" />
                        <MenuItem Icon="{controls:FluentIcon &#xF485;}"
                                  Header="{ci:Tr SettingsWindowNew.Header.DebugWindowRules}"
                                  Click="MenuItemDebugWindowRule_OnClick" />
                        <MenuItem Icon="{controls:FluentIcon &#xE0B1;}"
                                  Header="{ci:Tr SettingsWindowNew.Header.CreateAShortcut}">
                            <MenuItem.IsVisible>
                                <OnPlatform Default="False">
                                    <On Options="Windows" Content="True" />
                                    <On Options="Linux" Content="True" />
                                </OnPlatform>
                            </MenuItem.IsVisible>
                            <MenuItem Icon="{controls:FluentIcon &#xE62F;}"
                                      Header="{ci:Tr SettingsWindowNew.Header.CreateDesktopShortcuts}"
                                      Click="MenuItemAddDesktopShortcut_OnClick" />
                            <MenuItem Icon="{controls:FluentIcon &#xE06F;}"
                                      Header="{ci:Tr SettingsWindowNew.Header.CreateAShortcutForTheStartMenu}"
                                      Click="MenuItemAddStartMenuShortcut_OnClick" />
                            <MenuItem Icon="{controls:FluentIcon &#xE15F;}"
                                      Header="{ci:Tr SettingsWindowNew.Header.CreateAQuickCourseChangeIcon}"
                                      Click="MenuItemAddClassSwapShortcut_OnClick">
                                <MenuItem.IsVisible>
                                    <OnPlatform Default="False">
                                        <On Options="Windows" Content="True" />
                                    </OnPlatform>
                                </MenuItem.IsVisible>
                            </MenuItem>
                        </MenuItem>
                        <MenuItem Icon="{commands:FluentIcon &#xe083;}"
                                  Header="{ci:Tr SettingsWindowNew.Header.DataMigration}"
                                  Click="MenuItemDataTransfer_OnClick"/>
                        <Separator />
                        <MenuItem Icon="{controls:FluentIcon &#xE2B4;}" Header="{ci:Tr SettingsWindowNew.Header.CentralControlOptions}"
                                  Click="MenuItemOpenManagementSettingsPage_OnClick">
                        </MenuItem>
                        <MenuItem Icon="{controls:FluentIcon &#xE2B6;}" Header="{ci:Tr SettingsWindowNew.Header.JoinManagement}"
                                  IsVisible="{Binding !ManagementService.IsManagementEnabled}"
                                  Click="MenuItemJoinManagement_OnClick">

                        </MenuItem>
                        <MenuItem Icon="{controls:FluentIcon &#xE2B8;}" Header="{ci:Tr SettingsWindowNew.Header.ExitManagement}"
                                  Click="MenuItemExitManagement_OnClick"
                                  IsVisible="{Binding ManagementService.IsManagementEnabled}">
                        </MenuItem>
                        <Separator />
                        <MenuItem Icon="{controls:FluentIcon &#xE510;}"
                                  Header="{ci:Tr SettingsWindowNew.Header.Log}"
                                  Click="MenuItemAppLogs_OnClick" />
                        <MenuItem Icon="{controls:FluentIcon &#xE601;}"
                                  Header="{ci:Tr SettingsWindowNew.Header.ExportDiagnosticData}"
                                  Click="MenuItemExportDiagnosticInfo_OnClick" />
                        <MenuItem Icon="{controls:FluentIcon &#xF4C5;}"
                                  Header="{ci:Tr SettingsWindowNew.Header.RestartToRecoveryMode}"
                                  Click="MenuItemRestartToRecovery_OnClick" />
                        <Separator />
                        <MenuItem Icon="{controls:FluentIcon &#xE889;}"
                                  Header="{ci:Tr SettingsWindowNew.Header.OpenTheLogDirectory}"
                                  Click="MenuItemOpenLogFolder_OnClick" />
                        <MenuItem Icon="{controls:FluentIcon &#xE881;}"
                                  Header="{ci:Tr SettingsWindowNew.Header.OpenTheDataDirectory}"
                                  Click="MenuItemOpenDataFolder_OnClick" />
                        <MenuItem Icon="{controls:FluentIcon &#xE885;}"
                                  Header="{ci:Tr SettingsWindowNew.Header.OpenTheAppDirectory}"
                                  Click="MenuItemOpenAppFolder_OnClick" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </StackPanel>
    </NavigationPage.TopCommandBar>
    <controls1:ViewBase.HeaderTemplate>
        <DataTemplate>
            <Border Height="48" Margin="0 0 8 0">
                <Grid VerticalAlignment="Center" ColumnDefinitions="Auto,Auto,*,Auto">
                    <StackPanel Orientation="Horizontal" Grid.Column="1"
                                VerticalAlignment="Center">
                        <Button Name="BackButton"
                                Grid.Column=""
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0 -8 0 -8"
                                Click="BackButton_OnClick"
                                IsVisible="{Binding #NavigationFrame.CanGoBack}"
                                MinWidth="40" Width="48"
                                ToolTip.Tip="{ci:Tr SettingsWindowNew.ToolTip.Return}"
                                Classes="nav-back">
                        </Button>
                        <Button Name="TogglePaneButton"
                                Grid.Column=""
                                Theme="{StaticResource PaneToggleButtonStyle}"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Margin="0 -8 -8 -8"
                                Click="TogglePaneButton_OnClick"
                                IsVisible="{Binding !#NavigationView.IsPaneToggleButtonVisible}"
                                MinWidth="40" Width="48"/>

                        <Image Margin="0 4 12 4"
                               IsHitTestVisible="False"
                               Source="/Assets/AppLogo.png"
                               Width="18" Height="18"
                               DockPanel.Dock="Left"
                               Name="WindowIcon"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               Classes="custom-titlebar-only"/>

                        <TextBlock Text="{Binding Title, RelativeSource={RelativeSource FindAncestor, AncestorType=Window}}"
                                   FontSize="12" Margin="0 2 0 0"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center"
                                   Classes="custom-titlebar-only"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </controls1:ViewBase.HeaderTemplate>
    <controls1:ViewBase.Resources>
        <ScrollViewer Width="332" x:Key="ExperimentalSettings"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="16">
                <TextBlock Text="{ci:Tr SettingsWindowNew.Text.ExperimentalFeatures}" Theme="{StaticResource SubtitleTextBlockStyle}"
                           Margin="0 0 0 4" />
                <TextBlock Text="{ci:Tr SettingsWindowNew.Text.FeaturesUnderDevelopmentTestingThatMayBeUnstable}" TextWrapping="Wrap"
                           Margin="0 0 0 16" />
                    <CheckBox IsChecked="{Binding SettingsService.Settings.ShowEchoCaveWhenSettingsPageLoading}"
                          Margin="0 0 0 6"
                          IsEnabled="{Binding ManagementService.Policy.DisableEasterEggs, Converter={StaticResource BooleanToBooleanReConverter}}">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="{ci:Tr SettingsWindowNew.Content.ShowEchoHoleWhileLoadingTheSettingsPage}"/>
                        <Run TextDecorations="{x:Static TextDecorations.Strikethrough}" Text="{ci:Tr SettingsWindowNew.Content.ActuallyItUsuallyLoadsBeforeYouEvenFinish}"/>
                    </TextBlock>
                </CheckBox>
            </StackPanel>
        </ScrollViewer>

    </controls1:ViewBase.Resources>
    <input:CommandManager.CommandBindings>
        <input:CommandBinding Command="{x:Static controls1:SettingsPageBase.OpenDrawerCommand}" Executed="CommandBindingOpenDrawer_OnExecuted"/>
        <input:CommandBinding Command="{x:Static controls1:SettingsPageBase.CloseDrawerCommand}" Executed="CommandBindingCloseDrawer_OnExecuted"/>
        <input:CommandBinding Command="{x:Static controls1:SettingsPageBase.RequestRestartCommand}" Executed="CommandBindingRestartApp_OnExecuted"></input:CommandBinding>
    </input:CommandManager.CommandBindings>
    <Grid x:Name="RootGrid">
        <Grid RowDefinitions="Auto,*" Classes.invisible="{Binding ViewModel.IsCoverVisible}">
            <Grid.Styles>
                <Style Selector="Grid.invisible">
                    <Setter Property="Opacity" Value="0"/>
                </Style>
            </Grid.Styles>
            <controls3:FANavigationView Grid.Row="1"
                                        x:Name="NavigationView"
                                        PaneDisplayMode="Auto"
                                        IsSettingsVisible="False"
                                        MenuItems="{Binding ViewModel.NavigationViewItems, Mode=OneWay}"
                                        ItemInvoked="NavigationView_OnItemInvoked"
                                        BackRequested="NavigationView_OnBackRequested"
                                        Loaded="Control_OnLoaded"
                                        OpenPaneLength="283">
                <controls3:FANavigationView.Styles>
                    <Style Selector="controls3|FANavigationView#NavigationView:minimal">
                        <Setter Property="IsPaneToggleButtonVisible" Value="False"/>
                    </Style>
                </controls3:FANavigationView.Styles>
                <!-- 页面内容 -->
                <controls:DrawerHost IsDrawerOpen="{Binding ViewModel.IsDrawerOpen, Mode=TwoWay}"
                           DrawerPlacement="Right"
                           DrawerContent="{Binding ViewModel.DrawerContent}">
                    <Grid RowDefinitions="Auto, *">
                        <Grid Grid.Row="1"
                            HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                            Margin="32 8 8 16"
                                    Opacity="0.75" ColumnDefinitions="Auto,*">
                            <Grid.IsVisible>
                                <MultiBinding Converter="{StaticResource BooleanAndExpressionMultiConverter}">
                                    <Binding Path="SettingsService.Settings.ShowEchoCaveWhenSettingsPageLoading"/>
                                    <Binding Path="ViewModel.IsNavigating"/>
                                    <Binding Path="ManagementService.Policy.DisableEasterEggs" Converter="{StaticResource BooleanToBooleanReConverter}"/>
                                </MultiBinding>
                            </Grid.IsVisible>
                            <commands:FluentIcon Glyph="&#xEA8A;" VerticalAlignment="Center"
                                                 Grid.Column="0"/>
                            <TextBlock Text="{Binding ViewModel.CurrentEchoCaveText}"
                                       Grid.Column="1"
                                       TextWrapping="Wrap"
                                       FontWeight="Regular"
                                       VerticalAlignment="Center"
                                       Margin="4 0 0 0"/>
                        </Grid>
                        <Grid Grid.Row="0" Margin="12 16 18 0"
                              IsVisible="{Binding !ViewModel.SelectedPageInfo.HidePageTitle}"
                              Classes.FullWidth="{Binding ViewModel.SelectedPageInfo.UseFullWidth}"
                              x:Name="TitleContainer">
                            <Grid.Styles>
                                <Style Selector="Grid#TitleContainer:not(.FullWidth)">
                                    <Setter Property="MaxWidth" Value="{StaticResource SettingsContainerWidth}"/>
                                </Style>
                            </Grid.Styles>
                            <TextBlock FontWeight="Normal"
                                       Text="{Binding ViewModel.SelectedPageInfo.Name}"
                                       Theme="{StaticResource TitleTextBlockStyle}"/>
                        </Grid>
                        <controls3:FAFrame Grid.Row="1" Content="{Binding ViewModel.FrameContent}"
                                         Navigated="NavigationServiceOnLoadCompleted"
                                         Navigating="NavigationServiceOnNavigating"
                                         CacheSize="0"
                                         x:Name="NavigationFrame">
                        </controls3:FAFrame>
                    </Grid>
                </controls:DrawerHost>
            </controls3:FANavigationView>

        </Grid>

        <Border VerticalAlignment="Stretch" HorizontalAlignment="Stretch"
                IsVisible="{Binding ViewModel.IsCoverVisible}">
            <commands:ExpressiveLoadingIndicator IsActive="{Binding ViewModel.IsCoverVisible}"/>
        </Border>
    </Grid>
</controls1:ViewBase>
