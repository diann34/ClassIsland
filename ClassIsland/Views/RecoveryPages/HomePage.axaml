<UserControl x:Class="ClassIsland.Views.RecoveryPages.HomePage"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             Margin="8">

    <ScrollViewer>
        <ScrollViewer.Styles>
            <Style Selector="controls|FASettingsExpanderItem">
                <Setter Property="IsClickEnabled" Value="True"/>
            </Style>
        </ScrollViewer.Styles>
        <StackPanel Classes="animated-intro" Spacing="6">

            <TextBlock Text="{ci:Tr RecoveryPages.HomePage.Text.SelectAnOption}" Theme="{StaticResource SubtitleTextBlockStyle}"/>
            <TextBlock Text="{ci:Tr RecoveryPages.HomePage.Text.SelectAnActionToContinue}" Margin="0 2 0 10"/>

            <StackPanel Classes="cardContainer">
                <controls:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe131;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.ContinueUsingClassIsland}"
                                               ActionIconSource="{ci:FluentIconSource &#xe44e;}"
                                               Click="ButtonContinue_OnClick"/>
                <controls:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe131;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.ContinueUsingClassIslandInSafeMode}"
                                               Description="{ci:Tr RecoveryPages.HomePage.Description.DisableAllPluginsAndAutomationFeatures}"
                                               ActionIconSource="{ci:FluentIconSource &#xe44e;}"
                                               Click="ButtonContinueSafe_OnClick"/>
                <controls:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe131;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.ContinueUsingClassIslandInDiagnosticMode}"
                                               Description="{ci:Tr RecoveryPages.HomePage.Description.LogDetailedInformationAndEnableConsoleOutput}"
                                               ActionIconSource="{ci:FluentIconSource &#xe44e;}"
                                               Click="ButtonContinueDiagnostic_OnClick"/>
                <controls:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe889;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.OpenLogDirectory}"
                                               ActionIconSource="{ci:FluentIconSource &#xec2e;}"
                                               Click="ButtonOpenLogFolder_OnClick"/>
            </StackPanel>


            <StackPanel Classes="cardContainer">
                <controls:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe195;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.RestoreBackup}"
                                               Description="{ci:Tr RecoveryPages.HomePage.Description.RestoreTheCorrectlyConfiguredProfileFromAPrevious}"
                                               ActionIconSource="{ci:FluentIconSource &#xe44e;}"
                                               Click="ButtonRecoverBackup_OnClick"/>
                <controls:FASettingsExpanderItem Name="ButtonRollBack"
                                               IconSource="{ci:FluentIconSource &#xe135;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.Rollback}"
                                               Description="{ci:Tr RecoveryPages.HomePage.Description.RollBackToAPreviousVersionOfClassIsland}"
                                               ActionIconSource="{ci:FluentIconSource &#xe44e;}"
			                                   Click="ButtonRollBack_Onclick"
                                               IsEnabled="False"/>
            </StackPanel>

            <StackPanel Classes="cardContainer">
                <controls:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe623;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.ClearTemporaryFiles}"
                                               Description="{ci:Tr RecoveryPages.HomePage.Description.DeleteAllCachesAndTemporaryFiles}"
                                               ActionIconSource="{ci:FluentIconSource &#xe44e;}"
                                               Click="ButtonCleanTempFiles_OnClick"/>
                <controls:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe0bd;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.ResetApplicationSettings}"
                                               Description="{ci:Tr RecoveryPages.HomePage.Description.ResetApplicationSettingsInformationWithoutAffectingProfi}"
                                               ActionIconSource="{ci:FluentIconSource &#xe44e;}"
                                               Click="ButtonResetSettings_OnClick"/>
                <controls:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe6b9;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.ResetAllConfigurations}"
                                               Description="{ci:Tr RecoveryPages.HomePage.Description.ResetAllApplicationConfigurationsIncludingApplicationSet}"
                                               ActionIconSource="{ci:FluentIconSource &#xe44e;}"
                                               Click="ButtonResetConfigs_OnClick"/>
                <controls:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe12f;}"
                                               Content="{ci:Tr RecoveryPages.HomePage.Content.ResetAllInformation}"
                                               Description="{ci:Tr RecoveryPages.HomePage.Description.ResetAllApplicationInformationToThePreInstallation}"
                                               Click="ButtonResetAll_OnClick"
                                               ActionIconSource="{ci:FluentIconSource &#xe44e;}"/>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</UserControl>
