<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.PrivacySettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:controls2="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:PrivacySettingsPage}"
      Loaded="PrivacySettingsPage_OnLoaded"
      Unloaded="PrivacySettingsPage_OnUnloaded">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Tag="CanPolicyDisable">
            <StackPanel Margin="0 0 0 16">
                <TextBlock Text="{ci:Tr SettingPages.PrivacySettingsPage.Text.AnonymousUsageAnalysis}"
                           Theme="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Margin="0 6 0 0" TextWrapping="Wrap"
                           Text="{ci:Tr SettingPages.PrivacySettingsPage.Text.ThisAppWillUseTheSentrysdkToCollect}" />
                <TextBlock Margin="0 6 0 0" TextWrapping="Wrap">
                    <Run Text="{ci:Tr SettingPages.PrivacySettingsPage.Text.ForMoreInformationPleaseSee}">
                    </Run>
                    <HyperlinkButton Click="HyperlinkMsAppCenter_OnClick">
                        {ci:Tr SettingPages.PrivacySettingsPage.Content.ClassIslandPrivacyPolicy}
                    </HyperlinkButton>
                    。
                </TextBlock>
            </StackPanel>

            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xE4E8;}"
                                        Header="{ci:Tr SettingPages.PrivacySettingsPage.Header.EnableAnonymousUsageAnalysis}"
                                        Description="{ci:Tr SettingPages.PrivacySettingsPage.Description.AfterActivationTheAppWillCollectUsageData}">
                <controls2:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding SettingsService.Settings.IsSentryEnabled, Mode=TwoWay}"/>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
