<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:settingPages="clr-namespace:ClassIsland.Views.SettingPages"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:registry="clr-namespace:ClassIsland.Core.Services.Registry;assembly=ClassIsland.Core"
                  xmlns:components="clr-namespace:ClassIsland.Core.Models.Components;assembly=ClassIsland.Core"
                  xmlns:icons="clr-namespace:ClassIsland.Core.Icons;assembly=ClassIsland.Core"
                  xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  xmlns:converters="clr-namespace:ClassIsland.Converters"
                  xmlns:settingsPages="clr-namespace:ClassIsland.ViewModels.SettingsPages"
                  xmlns:models="clr-namespace:ClassIsland.Models"
                  xmlns:editMode="clr-namespace:ClassIsland.Controls.EditMode"
                  mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                  x:Class="ClassIsland.Views.SettingPages.ComponentsSettingsPage"
                   Loaded="ComponentsSettingsPage_OnLoaded"
                   Unloaded="ComponentsSettingsPage_OnUnloaded"
                  d:DataContext="{d:DesignInstance settingPages:ComponentsSettingsPage}">
    <ci:SettingsPageBase.Styles>
        <Style Selector="ListBox.drag-source ListBoxItem">
            <Setter Property="Interaction.Behaviors">
                <BehaviorCollectionTemplate>
                    <BehaviorCollection>
                        <ci:AdvancedManagedContextDragBehavior HorizontalDragThreshold="3" VerticalDragThreshold="3"/>
                    </BehaviorCollection>
                </BehaviorCollectionTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox.component-listBox">
            <Style.Resources>
                <MenuFlyout x:Key="ComponentsOperationMenuFlyout">
                    <MenuItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.MoveUpOneRow}" Icon="{ci:FluentIcon &#xe197;}"
                              Classes="main-only"
                              Command="{Binding $parent[settingPages:ComponentsSettingsPage].MoveComponentToPreviousLineCommand}"
                              CommandParameter="{Binding}"/>
                    <MenuItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.MoveDownOneRow}" Icon="{ci:FluentIcon &#xe0cb;}"
                              Classes="main-only"
                              Command="{Binding $parent[settingPages:ComponentsSettingsPage].MoveComponentToNextLineCommand}"
                              CommandParameter="{Binding}"/>
                    <MenuItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.MoveToSelectedContainer}" Icon="{ci:FluentIcon &#xe280;}"
                              IsEnabled="{Binding $parent[settingPages:ComponentsSettingsPage].ViewModel.IsComponentChildrenViewOpen}"
                              Classes="main-only"
                              Command="{Binding $parent[settingPages:ComponentsSettingsPage].MoveToCurrentContainerComponentCommand}"
                              CommandParameter="{Binding}"/>
                    <MenuItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.RemoveFromContainerComponent}" Icon="{ci:FluentIcon &#xe286;}"
                              Classes="children-only"
                              Command="{Binding $parent[settingPages:ComponentsSettingsPage].MoveComponentsToMainLinesCommand}"
                              CommandParameter="{Binding}"/>
                    <Separator/>
                    <MenuItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.WrapItInANewContainer}" Icon="{ci:FluentIcon &#xe27e;}"
                              ItemsSource="{Binding $parent[settingPages:ComponentsSettingsPage].ViewModel.ContainerComponents}">
                        <MenuItem.ItemContainerTheme>
                            <ControlTheme TargetType="MenuItem" BasedOn="{StaticResource {x:Type MenuItem}}">
                                <Setter Property="Header" Value="{Binding Name}"/>
                                <Setter Property="Icon">
                                    <Template>
                                        <Border>
                                            <controls:FAIconSourceElement IconSource="{Binding IconSource}"
                                                                        Height="14" Width="14"
                                                                        TextElement.FontSize="14"
                                                                        Classes="repair-fontsize"/>
                                        </Border>
                                    </Template>
                                </Setter>
                                <Setter Property="Command" Value="{Binding $parent[settingPages:ComponentsSettingsPage].CreateContainerComponentCommand}"/>
                                <Setter Property="CommandParameter" Value="{Binding}"/>
                            </ControlTheme>
                        </MenuItem.ItemContainerTheme>
                    </MenuItem>
                    <MenuItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.CreateACopy}" Icon="{ci:FluentIcon &#xeeb9;}"
                              Command="{Binding $parent[settingPages:ComponentsSettingsPage].DuplicateComponentCommand}"
                              CommandParameter="{Binding}"/>
                </MenuFlyout>
            </Style.Resources>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Auto"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="ItemTemplate">
                <DataTemplate DataType="{x:Type components:ComponentSettings}">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Stretch">
                        <ci:TouchDragThumb Margin="-4 0 -2 0" IsCompact="True"/>
                        <controls:FAIconSourceElement IconSource="{Binding AssociatedComponentInfo.IconSource}"
                                                    VerticalAlignment="Center" Height="14" Width="14"
                                                    ClipToBounds="False"
                                                    TextElement.FontSize="14"
                                                    Classes="repair-fontsize"/>
                        <TextBlock Text="{Binding AssociatedComponentInfo.Name}"
                                   VerticalAlignment="Center" />
                        <Button Content="{ci:FluentIcon &#xebac;}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.MoreOptions}"
                                Flyout="{StaticResource ComponentsOperationMenuFlyout}"
                                Theme="{StaticResource TransparentButton}"
                                IsVisible="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}">
                        </Button>
                        <Button Content="{ci:FluentIcon &#xEC30;}"
                                VerticalAlignment="Center"
                                ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.ViewSubcomponents}"
                                Click="ButtonShowChildrenComponents_OnClick"
                                Theme="{StaticResource TransparentButton}">
                            <Button.IsVisible>
                                <MultiBinding
                                    Converter="{StaticResource BooleanAndExpressionMultiConverter}">
                                    <Binding Path="IsSelected"
                                             RelativeSource="{RelativeSource FindAncestor, AncestorType=ListBoxItem}" />
                                    <Binding Path="AssociatedComponentInfo.IsComponentContainer" />
                                </MultiBinding>
                            </Button.IsVisible>
                        </Button>
                        <Button
                            Foreground="IndianRed"
                            VerticalAlignment="Center"
                            ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.Delete}"
                            IsVisible="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}"
                            Click="ButtonRemoveSelectedComponent_OnClick"
                            Theme="{StaticResource TransparentButton}"
                            Content="{ci:FluentIcon &#xE61D;}"/>
                    </StackPanel>
                </DataTemplate>
            </Setter>
            <Setter Property="ItemsPanel">
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                </ItemsPanelTemplate>
            </Setter>
            <Setter Property="ItemContainerTheme">
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Padding" Value="8 0"/>
                    <Setter Property="MinWidth" Value="0"/>
                    <Setter Property="VerticalAlignment" Value="Stretch"/>
                    <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                    <Setter Property="ContextFlyout" Value="{StaticResource ComponentsOperationMenuFlyout}"/>
                </ControlTheme>
            </Setter>

            <Style Selector="^#ListBoxComponentsChildren MenuItem.main-only">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^:not(#ListBoxComponentsChildren) MenuItem.children-only">
                <Setter Property="IsVisible" Value="False"/>
            </Style>
            <Style Selector="^ ListBoxItem">
                <Setter Property="(Interaction.Behaviors)">
                    <BehaviorCollectionTemplate>
                        <BehaviorCollection>
                            <ci:AdvancedManagedContextDragBehavior HorizontalDragThreshold="3" VerticalDragThreshold="3">
                                <ci:AdvancedManagedContextDragBehavior.Context>
                                    <MultiBinding Converter="{x:Static editMode:EditableComponentsListBoxDragData.Create}">
                                        <Binding />
                                        <Binding  Path="$parent[ListBox].ItemsSource"/>
                                    </MultiBinding>
                                </ci:AdvancedManagedContextDragBehavior.Context>
                            </ci:AdvancedManagedContextDragBehavior>
                        </BehaviorCollection>
                    </BehaviorCollectionTemplate>
                </Setter>
            </Style>
        </Style>
    </ci:SettingsPageBase.Styles>
    <ci:SettingsPageBase.Resources>
        <ci:HorizontalAlignmentToIntConverter x:Key="HorizontalAlignmentToIntConverter" />

        <ci:RulesetControl x:Key="RulesetControl" Classes="in-drawer"/>
    </ci:SettingsPageBase.Resources>
    <Grid Margin="12 0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition MinHeight="43.2" MaxHeight="250"
                           Height="64"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ROW 1 组件方案管理 -->
        <Grid Grid.Row="1" MaxWidth="{StaticResource SettingsContainerWidth}" ColumnDefinitions="*,Auto">
            <TextBlock Text="{ci:Tr SettingPages.ComponentsSettingsPage.Text.TheFollowingComponentsWillBeDisplayedOnThe}"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Left"/>
            <StackPanel Grid.Column="1" Grid.Row="0" Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="2"
                        VerticalAlignment="Center">
                <ci:Field Label="{ci:Tr SettingPages.ComponentsSettingsPage.Label.ConfigurationProfile}">
                    <ComboBox ItemsSource="{Binding ViewModel.ComponentsService.ComponentConfigs}"
                              MinWidth="150"
                              MaxWidth="300"
                              SelectedItem="{Binding ViewModel.SettingsService.Settings.CurrentComponentConfig, Converter={StaticResource PreventNullConverter}}" />
                </ci:Field>
                <Button Content="{ci:FluentIcon &#xE0B5;}"
                        ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.Refresh}"
                        VerticalAlignment="Center"
                        Click="ButtonRefresh_OnClick"
                        Theme="{StaticResource TransparentButton}"/>
                <Button Content="{ci:FluentIcon &#xE00D;}"
                        ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.New}"
                        VerticalAlignment="Center"
                        Click="ButtonCreateConfig_OnClick"
                        Theme="{StaticResource TransparentButton}"/>
                <Button Content="{ci:FluentIcon &#xE88D;}"
                        ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.OpenConfigurationFolder}"
                        VerticalAlignment="Center"
                        Click="ButtonOpenConfigFolder_OnClick"
                        Theme="{StaticResource TransparentButton}"/>
            </StackPanel>
        </Grid>

        <ListBox Grid.Row="2" ItemsSource="{Binding ViewModel.ComponentsService.CurrentComponents.Lines}"
                 SelectedItem="{Binding ViewModel.SelectedMainWindowLineSettings}"
                 x:Name="ListBoxMainWindowLines"
                 Margin="-12 0">
            <ListBox.ItemContainerTheme>
                <ControlTheme TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                    <Setter Property="Interaction.Behaviors">
                        <BehaviorCollectionTemplate>
                            <BehaviorCollection>
                                <ci:AdvancedItemDragBehavior Orientation="Vertical"
                                                             HorizontalDragThreshold="33550336"
                                                             AllowDragFromDragThumbOnly="True"/>
                            </BehaviorCollection>
                        </BehaviorCollectionTemplate>
                    </Setter>
                </ControlTheme>
            </ListBox.ItemContainerTheme>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid ColumnDefinitions="Auto, *, Auto" Height="40">
                        <ci:TouchDragThumb Grid.Column="0" Width="20" IsExplicitVisible="True"
                                           IsCompact="True"
                                           Classes="in-listbox"/>

                        <ListBox Grid.Column="1" ItemsSource="{Binding Children}"
                                 SelectionChanged="SelectorComponents_OnSelectionChanged"
                                 Tag="{Binding}"
                                 AttachedToVisualTree="ListBoxMainWindowLineSettings_OnAttachedToVisualTree"
                                 DetachedFromVisualTree="ListBoxMainWindowLineSettings_OnDetachedFromVisualTree"
                                 Classes="component-listBox">
                            <Interaction.Behaviors>
                                <BehaviorCollection>
                                    <ManagedContextDropBehavior
                                        Handler="{Binding $parent[settingPages:ComponentsSettingsPage].ViewModel.DropHandler}"
                                        Context="{Binding Children}"/>
                                </BehaviorCollection>
                            </Interaction.Behaviors>
                        </ListBox>

                        <Border Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right"
                                Padding="4"
                                CornerRadius="4"
                                Background="{DynamicResource AcrylicBackgroundFillColorBaseBrush}"
                                IsVisible="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}">
                            <StackPanel Orientation="Horizontal"
                                        VerticalAlignment="Center"
                                        Spacing="2">
                                <ToggleButton
                                    IsChecked="{Binding IsMainLine}"
                                    Click="ToggleButtonIsMainLine_OnIsCheckedChanged"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.ThisRowIsTheMainRow}"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="{ci:FluentIcon &#xE994;}" />
                                <ToggleButton
                                    IsChecked="{Binding IsNotificationEnabled}"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.ThisRowCanDisplayReminders}"
                                    Click="ToggleButtonIsNotificationEnabled_OnIsCheckedChanged"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Content="{ci:FluentIcon &#xE02B;}" />
                                <Button
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.InsertARowBelow}"
                                    Click="ButtonCreateMainWindowLine_OnClick"
                                    Theme="{StaticResource TransparentButton}"
                                    Content="{ci:FluentIcon &#xE00D;}" />
                                <Button
                                    Foreground="IndianRed"
                                    VerticalAlignment="Center"
                                    ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.Delete}"
                                    Click="ButtonRemoveSelectedMainWindowLine_OnClick"
                                    Theme="{StaticResource TransparentButton}"
                                    Content="{ci:FluentIcon &#xE61D;}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="3" Margin="-12 0" Height="2"/>

        <!-- ROW 4 组件设置 -->
        <Grid Grid.Row="4" HorizontalAlignment="Stretch"
              Margin="0 4 0 0"
              RowDefinitions="Auto, *">
            <Border Grid.Row="0" CornerRadius="4" ClipToBounds="True"
                    IsVisible="{Binding ViewModel.IsComponentChildrenViewOpen}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}">
                <Grid RowDefinitions="Auto, Auto">
                    <Border Grid.Row="0" Padding="8"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0 0 0 1">
                        <Grid ColumnDefinitions="Auto,*">
                            <Button Grid.Column="0" Content="{ci:FluentIcon &#xE0C7;}"
                                    Margin="0 -16 4 -16"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.ReturnToPreviousLevel}"
                                    IsVisible="{Binding ViewModel.CanChildrenNavigateBack, Mode=OneWay}"
                                    Click="ButtonNavigateUp_OnClick"
                                    Theme="{StaticResource TransparentButton}" />
                            <TextBlock VerticalAlignment="Center"
                                       Grid.Column="1"
                                       HorizontalAlignment="Left">
                                <Run Text="{ci:Tr SettingPages.ComponentsSettingsPage.Text.ChildComponentsOfThisComponent}" />
                            </TextBlock>
                            <Button Grid.Column="1" Content="{ci:FluentIcon &#xE671;}"
                                    Margin="4 -16 -4 -16"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Right"
                                    ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.Close}"
                                    Click="ButtonChildrenViewClose_OnClick"
                                    Theme="{StaticResource TransparentButton}" />
                        </Grid>
                    </Border>
                    <ListBox Grid.Row="1" ItemsSource="{Binding ViewModel.SelectedComponentContainerChildren}"
                             Classes="component-listBox"
                             x:Name="ListBoxComponentsChildren"
                             SelectionChanged="SelectorComponentsChildren_OnSelectionChanged">
                        <Interaction.Behaviors>
                            <BehaviorCollection>
                                <ManagedContextDropBehavior Handler="{Binding $parent[settingPages:ComponentsSettingsPage].ViewModel.DropHandler}"
                                                     Context="{Binding ViewModel.SelectedComponentContainerChildren}"/>
                            </BehaviorCollection>
                        </Interaction.Behaviors>
                    </ListBox>
                </Grid>
            </Border>

            <TabControl Grid.Row="1"
                        HorizontalContentAlignment="Stretch"
                        Padding="0"
                        MaxWidth="{StaticResource SettingsContainerWidth}"
                        Classes="compact"
                        SelectedIndex="{Binding ViewModel.SettingsTabControlIndex}">
                <TabItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.ComponentLibrary}">
                    <!-- 按来源分组展示组件库 -->
                    <ScrollViewer Padding="0" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding ViewModel.GroupedComponents}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="components:ComponentGroup">
                                    <StackPanel Margin="0 4 0 8">
                                        <TextBlock Text="{Binding GroupName}"
                                                   FontWeight="SemiBold"
                                                   Margin="0 8 0 4"/>
                                        <ListBox ItemsSource="{Binding Components}"
                                                 Classes="drag-source"
                                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid HorizontalAlignment="Stretch" RowDefinitions="Auto,*" ColumnDefinitions="Auto,Auto,*,Auto"
                                                      Margin="0 8" Height="50">
                                                    <ci:TouchDragThumb Grid.Column="0" Grid.Row="0" Grid.RowSpan="2"
                                                                       Width="24"/>

                                                    <controls:FAIconSourceElement Grid.Column="1" Grid.Row="0"
                                                                                Grid.RowSpan="2"
                                                                                Width="32" Height="32"
                                                                                VerticalAlignment="Center"
                                                                                ClipToBounds="False"
                                                                                TextElement.FontSize="32"
                                                                                Classes="repair-fontsize"
                                                                                Margin="0 -4 4 0"
                                                                                IconSource="{Binding IconSource}"/>
                                                    <TextBlock Grid.Row="0" Grid.Column="2"
                                                               Text="{Binding Name}"
                                                               HorizontalAlignment="Left"
                                                               VerticalAlignment="Top"
                                                               Margin="0 0 0 1"
                                                               TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Row="1" Grid.Column="2"
                                                               Text="{Binding Description}"
                                                               Opacity="0.75"
                                                               FontSize="12"
                                                               FontWeight="Regular"
                                                               TextWrapping="Wrap"
                                                               HorizontalAlignment="Stretch"
                                                               TextAlignment="Left"
                                                               TextTrimming="CharacterEllipsis"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel>
                                                    <Interaction.Behaviors>
                                                        <BehaviorCollection>
                                                            <ci:WrapPanelAutoResizeBehavior TargetWidth="225"/>
                                                        </BehaviorCollection>
                                                    </Interaction.Behaviors>
                                                </WrapPanel>
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.ComponentSettings}" IsVisible="{Binding ViewModel.IsComponentSettingsVisible}">
                    <ci:ComponentPresenter Settings="{Binding ViewModel.SelectedComponentSettings}"
                                           IsPresentingSettings="True"/>
                </TabItem>
                <TabItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.AdvancedSettings}" IsVisible="{Binding ViewModel.IsComponentAdvancedSettingsVisible}">
                    <ci:ComponentAdvancedSettingsControl Settings="{Binding ViewModel.SelectedComponentSettings}"
                                                         RequestOpenHideRules="ButtonOpenRuleset_OnClick"
                                                         IsRootComponent="{Binding ViewModel.IsSelectedComponentOnRoot}"/>
                </TabItem>
                <TabItem Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.RowSettings}" IsVisible="{Binding ViewModel.SelectedMainWindowLineSettings, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ScrollViewer HorizontalAlignment="Stretch"
                                  DataContext="{Binding ViewModel.SelectedMainWindowLineSettings}">
                        <StackPanel Classes="settings-container animated-intro" Margin="0">
                            <!-- 按规则隐藏 -->
                            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEFBF;}"
                                                       Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.HideByRules}"
                                                       Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.AutomaticallyHideThisComponentWhenTheSpecifiedConditions}">
                                <controls:FASettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal">
                                        <Button HorizontalAlignment="Left"
                                                Theme="{StaticResource TransparentButton}"
                                                Click="ButtonOpenMainWindowLineRuleset_OnClick"
                                                IsVisible="{Binding HideOnRule}">
                                            <ci:IconText Glyph="&#xF17E;" Text="{ci:Tr SettingPages.ComponentsSettingsPage.Text.EditRuleSet}" />
                                        </Button>
                                        <ToggleSwitch VerticalAlignment="Center"
                                                      IsChecked="{Binding HideOnRule}" />
                                    </StackPanel>
                                </controls:FASettingsExpander.Footer>
                            </controls:FASettingsExpander>
                            <!-- 不透明度 -->
                            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xf023;}"
                                                       Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.SplitMainInterface}"
                                                       Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.AfterActivationTheMainInterfaceWillBeSeparated}">
                                <controls:FASettingsExpander.Footer>
                                    <ComboBox SelectedIndex="{Binding IslandSeparationMode}">
                                        <ComboBoxItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.Inherit}"/>
                                        <ComboBoxItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.Disable}"/>
                                        <ComboBoxItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.Enable}"/>
                                    </ComboBox>
                                </controls:FASettingsExpander.Footer>
                            </controls:FASettingsExpander>

                            <Separator Margin="0 12 0 4" />
                            <ci:IconText Glyph="&#xec4a;" Text="{ci:Tr SettingPages.ComponentsSettingsPage.Text.Appearance}" Margin="0 0 0 4" />

                            <!-- 不透明度 -->
                            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF37D;}"
                                                       Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.Opacity}"
                                                       Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.TheOverallOpacityOfTheMainInterfaceRow}">
                                <controls:FASettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Width="180" Minimum="0.1" Maximum="1"
                                                Classes="auto-tooltip"
                                                ci:SliderDragTooltipAssist.StringFormat="F2"
                                                Value="{Binding Opacity}"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True" />
                                    </StackPanel>
                                </controls:FASettingsExpander.Footer>
                            </controls:FASettingsExpander>

                            <controls:FASettingsExpander Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.CustomBackgroundEffect}"
                                                       Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.CustomMainInterfaceBackgroundEffectsAvailableOnlyOn}">
                                <controls:FASettingsExpander.IconSource>
                                    <ci:FluentIconSource Glyph="{x:Static icons:FluentIcons.BlurRegular}" />
                                </controls:FASettingsExpander.IconSource>
                                <controls:FASettingsExpander.IsVisible>
                                    <OnPlatform Default="False">
                                        <On Options="Windows" Content="True" />
                                    </OnPlatform>
                                </controls:FASettingsExpander.IsVisible>
                                <controls:FASettingsExpander.Footer>
                                    <ComboBox SelectedIndex="{Binding BackgroundMaterialOverrideMode}">
                                        <ComboBoxItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.Inherit}"/>
                                        <ComboBoxItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.Disable}"/>
                                        <ComboBoxItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.Enable}"/>
                                    </ComboBox>
                                </controls:FASettingsExpander.Footer>
                                <controls:FASettingsExpanderItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.MaterialType}">
                                    <controls:FASettingsExpanderItem.Footer>
                                        <ComboBox SelectedIndex="{Binding BackgroundMaterialType, Mode=TwoWay, Converter={x:Static ci:EnumToIntConverter.Instance}}">
                                            <ComboBoxItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.Acrylic}"/>
                                            <ComboBoxItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.GlassLike}"/>
                                            <ComboBoxItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.Mica}"/>
                                        </ComboBox>
                                    </controls:FASettingsExpanderItem.Footer>
                                </controls:FASettingsExpanderItem>
                            </controls:FASettingsExpander>

                            <!--自定义背景颜色-->
                            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE523;}"
                                                       Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.CustomBackgroundColor}"
                                                       Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.CurrentMainInterfaceRowBackgroundColorWillUse}">
                                <controls:FASettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal">

                                        <ColorPicker
                                            VerticalAlignment="Center"
                                            Margin="0 0 6 0"
                                            Color="{Binding BackgroundColor, Mode=TwoWay}"
                                            IsVisible="{Binding IsCustomBackgroundColorEnabled}"/>
                                        <ToggleSwitch VerticalAlignment="Center"
                                                      IsChecked="{Binding IsCustomBackgroundColorEnabled}" />
                                    </StackPanel>
                                </controls:FASettingsExpander.Footer>
                            </controls:FASettingsExpander>

                            <!-- 自定义背景不透明度 -->
                            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF37D;}"
                                                       Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.CustomBackgroundOpacity}"
                                                       Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.OpacityOfTheBackgroundOfTheCurrentMain}">
                                <controls:FASettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Width="180" Minimum="0" Maximum="1"
                                                Classes="auto-tooltip"
                                                ci:SliderDragTooltipAssist.StringFormat="F2"
                                                Value="{Binding BackgroundOpacity}"
                                                TickFrequency="0.05"
                                                IsSnapToTickEnabled="True"
                                                IsVisible="{Binding IsCustomBackgroundOpacityEnabled}"/>
                                        <ToggleSwitch VerticalAlignment="Center"
                                                      IsChecked="{Binding IsCustomBackgroundOpacityEnabled}" />
                                    </StackPanel>
                                </controls:FASettingsExpander.Footer>
                            </controls:FASettingsExpander>

                            <!-- 自定义背景圆角半径 -->
                            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF031;}"
                                                       Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.CustomBackgroundCornerRadius}"
                                                       Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.TheCurrentMainInterfaceBackgroundFilletRadiusWhen}">
                                <controls:FASettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal">
                                        <Slider Grid.Row="0" Width="180" Minimum="0" Maximum="20"
                                                Value="{Binding CustomCornerRadius}"
                                                TickFrequency="0.5"
                                                ci:SliderDragTooltipAssist.StringFormat="F1"
                                                Classes="auto-tooltip"
                                                IsSnapToTickEnabled="True"
                                                VerticalAlignment="Center"
                                                IsVisible="{Binding IsCustomCornerRadiusEnabled}"/>
                                        <ToggleSwitch VerticalAlignment="Center"
                                                      IsChecked="{Binding IsCustomCornerRadiusEnabled}" />
                                    </StackPanel>
                                </controls:FASettingsExpander.Footer>
                            </controls:FASettingsExpander>

                            <Separator Margin="0 12 0 4" />
                            <ci:IconText Glyph="&#xF26F;" Text="{ci:Tr SettingPages.ComponentsSettingsPage.Text.Font}" Margin="0 0 0 4" />
                            <!-- 字体大小 -->
                            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF273;}"
                                                        Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.FontSize}"
                                                        Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.AdjustTheSizeOfVariousFontsOnComponents}"
                                                        IsExpanded="{Binding IsResourceOverridingEnabled, Mode=OneWay}">
                                <controls:FASettingsExpander.Footer>
                                    <ToggleSwitch IsChecked="{Binding IsResourceOverridingEnabled}"/>
                                </controls:FASettingsExpander.Footer>
                                <controls:FASettingsExpander.Styles>
                                    <Style Selector="ci|Field">
                                        <Setter Property="Width" Value="175" />
                                        <Setter Property="Suffix" Value="px" />
                                        <Style Selector="^ controls|FANumberBox">
                                            <Setter Property="SpinButtonPlacementMode" Value="Inline" />
                                            <Setter Property="Minimum" Value="1" />
                                            <Setter Property="Maximum" Value="40" />
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                        </Style>
                                    </Style>
                                </controls:FASettingsExpander.Styles>
                                <controls:FASettingsExpanderItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.SecondaryFontSize}"
                                                                Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.AdditionalInformationAtTimePointsEtc}">

                                    <controls:FASettingsExpanderItem.Footer>
                                        <ci:Field>
                                            <controls:FANumberBox
                                                Value="{Binding MainWindowSecondaryFontSize, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                        </ci:Field>
                                    </controls:FASettingsExpanderItem.Footer>
                                </controls:FASettingsExpanderItem>
                                <controls:FASettingsExpanderItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.BodyFontSize}"
                                                                Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.DefaultFontSizeOnTheMainInterface}">

                                    <controls:FASettingsExpanderItem.Footer>
                                        <ci:Field>
                                            <controls:FANumberBox
                                                Value="{Binding MainWindowBodyFontSize, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                        </ci:Field>
                                    </controls:FASettingsExpanderItem.Footer>
                                </controls:FASettingsExpanderItem>
                                <controls:FASettingsExpanderItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.EmphasizeFontSize}"
                                                                Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.ContentSuchAsTimetableClockReminderTitlesWeather}">

                                    <controls:FASettingsExpanderItem.Footer>
                                        <ci:Field>
                                            <controls:FANumberBox
                                                Value="{Binding MainWindowEmphasizedFontSize, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                        </ci:Field>
                                    </controls:FASettingsExpanderItem.Footer>
                                </controls:FASettingsExpanderItem>
                                <controls:FASettingsExpanderItem Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.LargeFontSize}"
                                                                Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.ContentSuchAsCourseForecastEtc}">

                                    <controls:FASettingsExpanderItem.Footer>
                                        <ci:Field>
                                            <controls:FANumberBox
                                                Value="{Binding MainWindowLargeFontSize, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                                        </ci:Field>
                                    </controls:FASettingsExpanderItem.Footer>
                                </controls:FASettingsExpanderItem>
                            </controls:FASettingsExpander>
                            <!-- 字体颜色 -->
                            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF22A;}"
                                                        Header="{ci:Tr SettingPages.ComponentsSettingsPage.Header.FontColor}"
                                                        Description="{ci:Tr SettingPages.ComponentsSettingsPage.Description.AdjustFontColorWillOverrideTheValuesSet}">
                                <controls:FASettingsExpander.Footer>
                                    <StackPanel Orientation="Horizontal">
                                        <ColorPicker
                                            VerticalAlignment="Center"
                                            Margin="0 0 6 0"
                                            Color="{Binding ForegroundColor, Mode=TwoWay}"
                                            IsVisible="{Binding IsCustomForegroundColorEnabled}"/>
                                        <ToggleSwitch VerticalAlignment="Center"
                                                      IsChecked="{Binding IsCustomForegroundColorEnabled}" />
                                    </StackPanel>
                                </controls:FASettingsExpander.Footer>
                            </controls:FASettingsExpander>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                        Spacing="4"
                        IsVisible="{Binding ViewModel.SelectedComponentSettings, Converter={x:Static ObjectConverters.IsNotNull}}"
                        Margin="0 0 0 0">
                <ci:AnimatedIconButton
                        Theme="{StaticResource TransparentButton}"
                        IsEnabled="{Binding ViewModel.SelectedComponentSettings.HideOnRule}"
                        Classes.fade="{Binding !ViewModel.SelectedComponentSettings.HideOnRule}"
                        IsKeepingExpanded="{Binding ViewModel.SelectedComponentSettings.HideOnRule}"
                        Glyph="&#xF17E;"
                        Text="{ci:Tr SettingPages.ComponentsSettingsPage.Text.Edit}"
                        Click="ButtonOpenRuleset_OnClick"
                        ToolTip.Tip="{ci:Tr SettingPages.ComponentsSettingsPage.ToolTip.EditRuleSet}"/>
                <CheckBox IsChecked="{Binding ViewModel.SelectedComponentSettings.HideOnRule}" Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.HideByRules}"/>
            </StackPanel>
        </Grid>

        <controls:FAInfoBar Grid.Row="5" Grid.Column="0"
                          Message="{ci:Tr SettingPages.ComponentsSettingsPage.Message.NewFeatureYouCanNowUseEditMode}"
                          IsOpen="True">
            <controls:FAInfoBar.ActionButton>
                <Button Content="{ci:Tr SettingPages.ComponentsSettingsPage.Content.EnterEditMode}"
                        Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                        CommandParameter="classisland://app/edit?fromSettingsPage=true"/>
            </controls:FAInfoBar.ActionButton>
        </controls:FAInfoBar>
    </Grid>
</ci:SettingsPageBase>
