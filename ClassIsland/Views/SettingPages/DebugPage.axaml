<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.DebugPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:controls3="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:DebugPage}">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro"
                    IsVisible="{Binding !ViewModel.ManagementService.Policy.DisableDebugMenu}">
            <controls3:FAInfoBar Severity="Error"
                               Message="{ci:Tr SettingPages.DebugPage.Message.ForDebuggingOnlyUnlessYouKnowWhatYou}"
                               IsOpen="True"
                               IsClosable="False"/>

            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xe2c8;}"
                                        Header="{ci:Tr SettingPages.DebugPage.Header.EnableTheDebugMenu}">
                <controls3:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsDebugOptionsEnabled}"/>
                </controls3:FASettingsExpander.Footer>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.DebugMenu}">
                    <controls3:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsDebugEnabled}"/>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.MainWindowDebugInterface}">
                    <controls3:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsMainWindowDebugEnabled}"/>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
            </controls3:FASettingsExpander>

            <controls3:FASettingsExpander Header="{ci:Tr SettingPages.DebugPage.Header.DeviationOfDebuggingTime}" IconSource="{ci:FluentIconSource &#xe4c4;}"
                                        IsExpanded="True">
                <controls3:FASettingsExpanderItem>
                    <StackPanel Orientation="Horizontal" Spacing="4" Loaded="TargetTime_OnLoaded">
                        <CalendarDatePicker SelectedDate="{Binding ViewModel.TargetDate}"
                                            SelectedDateChanged="DatePicker_OnSelectedDateChanged"
                                            Loaded="TargetDate_OnLoaded"/>
                        <TimePicker SelectedTime="{Binding ViewModel.TargetTime}"
                                    SelectedTimeChanged="TimePicker_OnSelectedTimeChanged"
                                    Loaded="TargetTime_OnLoaded"
                                    UseSeconds="True"/>
                        <Button Content="{ci:Tr SettingPages.DebugPage.Content.Reset}" Click="ButtonReset_OnClick"/>
                    </StackPanel>
                </controls3:FASettingsExpanderItem>
            </controls3:FASettingsExpander>

            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xe47a;}"
                                        Header="{ci:Tr SettingPages.DebugPage.Header.CourseServices}">
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.TriggerClassStart}" Click="MenuItemDebugTriggerOnClass_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.TriggerClassEnd}" Click="MenuItemDebugTriggerAfterClass_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.StartMainTimer}" Click="MenuItemStartMainTimer_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.StopMainTimer}" Click="MenuItemStopMainTimer_OnClick"
                                                IsClickEnabled="True"/>
            </controls3:FASettingsExpander>
            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xef27;}"
                                        Header="{ci:Tr SettingPages.DebugPage.Header.ApplicationSettings}">
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.OverrideSettingsVersion}" Click="MenuItemOverwriteSettingsVersion_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.ShowPluginUsageInstructions}" Click="MenuItemShowPluginMarketWarning_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.ShowAutomationUsageInstructions}" Click="MenuItemShowAutomationWarning_OnClick"
                                                IsClickEnabled="True"/>
            </controls3:FASettingsExpander>
            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xe84f;}"
                                        Header="{ci:Tr SettingPages.DebugPage.Header.FunctionalTesting}">
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.DumpScheduleRelationshipDiagram}" Click="MenuItemDumpProfileRelations_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.OpenMarkdownDocument}" Click="MenuItemOpenMdDocs_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.ShowTestNotifications}" Click="MenuItemShowTestNotification_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.TestPositioning}" Click="MenuItemTryGetLocation_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.CentralizedControlManagementInProgress}">
                    <controls3:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.ManagementService.IsManagementEnabled}"
                                      IsEnabled="{Binding !ViewModel.ManagementService.IsManagementEnabled, Mode=OneTime}" />
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>

            </controls3:FASettingsExpander>
            <controls3:FASettingsExpander Header="{ci:Tr SettingPages.DebugPage.Header.GarbageCollection}" IconSource="{ci:FluentIconSource &#xe1fd;}"
                                        IsClickEnabled="True"
                                        Click="MenuItemGcCollect_OnClick"/>
            <!-- 时间流速 -->
            <controls3:FASettingsExpander Header="{ci:Tr SettingPages.DebugPage.Header.TimeFlow}" IconSource="{ci:FluentIconSource &#xe4d2;}"
                                        Description="{ci:Tr SettingPages.DebugPage.Description.ContinuouslyAdjustTimeOffsetToControlTimeFlow}">
                <controls3:FASettingsExpander.Footer>
                    <Grid HorizontalAlignment="Stretch" ColumnDefinitions="*,*,*">
                        <!--<Slider Grid.Column="0"
                                Value="{Binding ViewModel.SettingsService.Settings.DebugTimeSpeed, Mode=TwoWay}"
                                MinWidth="200"
                                TickFrequency="10" Minimum="-100" Maximum="500" IsSnapToTickEnabled="True"/>-->
                        <NumericUpDown Grid.Column="1"
                                       Value="{Binding ViewModel.SettingsService.Settings.DebugTimeSpeed}"
                                       MinWidth="102"/>
                        <Button Grid.Column="2" Click="ButtonResetTimeSpeed_OnClick"
                                ToolTip.Tip="{ci:Tr SettingPages.DebugPage.ToolTip.ResetTheTimeFlowRate}"
                                Theme="{StaticResource TransparentButton}"
                                Content="{ci:FluentIcon &#xe4cc;}"/>
                    </Grid>
                </controls3:FASettingsExpander.Footer>
            </controls3:FASettingsExpander>

            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xf431;}"
                                        Header="{ci:Tr SettingPages.DebugPage.Header.DangerousOperations}"
                                        Description="{ci:Tr SettingPages.DebugPage.Description.DonTPressUnlessYouHaveTheChance}">
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.CrashTest}" Click="ButtonCrash_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.CrashTest3SecondDelay}" Click="ButtonDelayCrash_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.CrashTestTask}" Click="MenuItemCrashOnTask_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.DebugPage.Content.CrashTestThrowToStackTop}" Click="MenuItemCrashTestGlobal_OnClick"
                                                IsClickEnabled="True"/>
                <controls3:FASettingsExpanderItem Content="Environment.FailFast();" Click="MenuItemFailFast_OnClick"
                                                IsClickEnabled="True"/>

            </controls3:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
