<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:enums="clr-namespace:ClassIsland.Shared.Enums;assembly=ClassIsland.Shared"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:settingPages="clr-namespace:ClassIsland.Views.SettingPages"
             xmlns:converters="clr-namespace:ClassIsland.Converters"
             xmlns:appUpdating="clr-namespace:ClassIsland.Enums.AppUpdating"
             xmlns:mdxaml="https://github.com/whistyun/Markdown.Avalonia"
             xmlns:helpers="clr-namespace:ClassIsland.Core.Helpers;assembly=ClassIsland.Core"
             xmlns:classIsland="clr-namespace:ClassIsland"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Views.SettingPages.UpdateSettingsPage"
             d:DataContext="{d:DesignInstance settingPages:UpdateSettingsPage}"
             Loaded="Control_OnLoaded" Unloaded="Control_OnUnloaded">
    <ci:SettingsPageBase.Resources>
        <converters:SizeLongToStringConverter x:Key="SizeLongToStringConverter" />
        <Grid x:Key="DownloadInfoDrawer" Margin="16" Width="450" RowDefinitions="Auto,*">
            <TextBlock Text="{ci:Tr SettingPages.UpdateSettingsPage.Text.DownloadProgress}" Grid.Row="0"
                       Theme="{StaticResource SubtitleTextBlockStyle}" />
            <ListBox Grid.Row="1" ItemsSource="{Binding ViewModel.UpdateService.DownloadTasks}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid ColumnDefinitions="* Auto" RowDefinitions="Auto Auto Auto">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{Binding FileName}"
                                       TextTrimming="{x:Static TextTrimming.CharacterEllipsis}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Opacity="0.75">
                                <Run Text="{Binding State, Converter={x:Static settingPages:UpdateSettingsPage.DownloadStateToMessageConverter}, Mode=OneWay}"/>
                            </TextBlock>
                            <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Grid.Column="0"
                                         Minimum="0" Maximum="{Binding FileSize}" Value="{Binding DownloadedSize}">
                                <ProgressBar.IsVisible>
                                    <Binding Path="State" Converter="{x:Static ObjectConverters.Equal}">
                                        <Binding.ConverterParameter>
                                            <appUpdating:DownloadState>Downloading</appUpdating:DownloadState>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </ProgressBar.IsVisible>
                            </ProgressBar>
                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Grid.Column="0" Opacity="0.6">
                                <TextBlock.IsVisible>
                                    <Binding Path="State" Converter="{x:Static ObjectConverters.Equal}">
                                        <Binding.ConverterParameter>
                                            <appUpdating:DownloadState>Downloading</appUpdating:DownloadState>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </TextBlock.IsVisible>

                                <Run
                                    Text="{Binding DownloadedSize, Converter={StaticResource SizeLongToStringConverter}}" /><Run Text="/" /><Run
                                                    Text="{Binding FileSize, Converter={StaticResource SizeLongToStringConverter}}" />
                                <Run
                                    Text="{Binding DownloadSpeed, Converter={StaticResource SizeLongToStringConverter}}" /><Run Text="/s" />
                                <Run Text="ETA" />
                                <Run Text="{Binding TimeToComplete}" />
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>
        <Grid x:Key="ChangeLogDrawer" Width="500">
            <mdxaml:MarkdownScrollViewer
                Engine="{x:Static helpers:MarkdownConvertHelper.Engine}"
                Margin="12"
                Markdown="{Binding ViewModel.ChangeLogDocument}">
                <mdxaml:MarkdownScrollViewer.Styles>
                    <StyleInclude Source="avares://ClassIsland.Core/Themes/RichTextStyles.axaml" />
                </mdxaml:MarkdownScrollViewer.Styles>
            </mdxaml:MarkdownScrollViewer>
        </Grid>
    </ci:SettingsPageBase.Resources>
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" Spacing="6">
            <Grid ColumnDefinitions="Auto *" RowDefinitions="Auto Auto">
                <ci:FluentIcon Grid.Column="0" FontSize="48"
                               Grid.RowSpan="2" Grid.Row="0"
                               Margin="0 0 4 0"
                               VerticalAlignment="Center"
                               RenderTransformOrigin="50%, 50%"
                               Glyph="{Binding ViewModel.SettingsService.Settings.LastUpdateStatus, Converter={x:Static settingPages:UpdateSettingsPage.UpdateStatusToIconGlyphConverter}}">
                    <ci:FluentIcon.RenderTransform>
                        <RotateTransform/>
                    </ci:FluentIcon.RenderTransform>
                    <ci:FluentIcon.Styles>
                        <Style Selector="ci|FluentIcon.Spinning">
                            <Style.Animations>
                                <Animation Duration="0:0:1" IterationCount="Infinite" Easing="0.50, 0.25, 0.50, 0.75">
                                    <KeyFrame Cue="0%">
                                        <Setter Property="RotateTransform.Angle" Value="0"/>
                                    </KeyFrame>
                                    <KeyFrame Cue="100%">
                                        <Setter Property="RotateTransform.Angle" Value="360"/>
                                    </KeyFrame>
                                </Animation>
                            </Style.Animations>
                        </Style>
                    </ci:FluentIcon.Styles>
                    <Classes.Spinning>
                        <Binding Path="ViewModel.UpdateService.CurrentWorkingStatus"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <enums:UpdateWorkingStatus>DownloadingUpdates</enums:UpdateWorkingStatus>
                            </Binding.ConverterParameter>
                        </Binding>
                    </Classes.Spinning>
                </ci:FluentIcon>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ViewModel.SettingsService.Settings.LastUpdateStatus, Converter={x:Static settingPages:UpdateSettingsPage.UpdateStatusToMessageConverter}}"
                           FontSize="24" FontWeight="Medium"/>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0 4 0 0">
                    <TextBlock.IsVisible>
                        <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus" Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <enums:UpdateStatus>UpToDate</enums:UpdateStatus>
                            </Binding.ConverterParameter>
                        </Binding>
                    </TextBlock.IsVisible>
                    <Run Text="{ci:Tr SettingPages.UpdateSettingsPage.Text.LastInspectionUpdateTime}"/>
                    <Run Text="{Binding ViewModel.SettingsService.Settings.LastCheckUpdateTime, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0 4 0 0">
                    <TextBlock.IsVisible>
                        <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus" Converter="{x:Static ObjectConverters.NotEqual}">
                            <Binding.ConverterParameter>
                                <enums:UpdateStatus>UpToDate</enums:UpdateStatus>
                            </Binding.ConverterParameter>
                        </Binding>
                    </TextBlock.IsVisible>
                    <Run Text="{ci:Tr SettingPages.UpdateSettingsPage.Text.DiscoverTheNewVersion}"/>
                    <Run Text="{Binding ViewModel.UpdateService.DistributionInfo.Version, Mode=OneWay}" />
                </TextBlock>
            </Grid>
            <controls:FAInfoBar Severity="Error" Title="{ci:Tr SettingPages.UpdateSettingsPage.Title.IfAnErrorOccursDuringAnUpdateCheck}"
                              Message="{Binding ViewModel.UpdateService.NetworkErrorException.Message, FallbackValue=''}"
                              IsOpen="{Binding ViewModel.UpdateService.NetworkErrorException, Converter={x:Static ObjectConverters.IsNotNull}, Mode=OneWay}"
                              CloseButtonClick="InfoBarError_OnCloseButtonClick"/>
            <controls:FAInfoBar Severity="Error" Title="{ci:Tr SettingPages.UpdateSettingsPage.Title.AnErrorOccurredDuringDeploymentPleaseTryAgain}"
                              Message="{Binding ViewModel.UpdateService.DeployErrorException.Message, FallbackValue=''}"
                              IsOpen="{Binding ViewModel.UpdateService.DeployErrorException, Converter={x:Static ObjectConverters.IsNotNull}, Mode=OneWay}"
                              CloseButtonClick="InfoBarDeployError_OnCloseButtonClick"/>
            <controls:FAInfoBar Severity="Informational" Title="{ci:Tr SettingPages.UpdateSettingsPage.Title.UpdateWillBeAppliedAfterTheRestart}" Message="{ci:Tr SettingPages.UpdateSettingsPage.Message.TheUpdateHasBeenSuccessfullyDeployedAndThe}">
                <controls:FAInfoBar.IsOpen>
                    <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus"
                             Converter="{x:Static ObjectConverters.Equal}">
                        <Binding.ConverterParameter>
                            <enums:UpdateStatus>UpdateDeployed</enums:UpdateStatus>
                        </Binding.ConverterParameter>
                    </Binding>
                </controls:FAInfoBar.IsOpen>
            </controls:FAInfoBar>
            <WrapPanel Classes="animated-resize">
                <WrapPanel.IsEnabled>
                    <Binding Path="ViewModel.UpdateService.CurrentWorkingStatus"
                             Converter="{x:Static ObjectConverters.Equal}">
                        <Binding.ConverterParameter>
                            <enums:UpdateWorkingStatus>Idle</enums:UpdateWorkingStatus>
                        </Binding.ConverterParameter>
                    </Binding>
                </WrapPanel.IsEnabled>
                <Button Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.CheckForUpdates}" Classes="accent" Margin="4"
                        Click="ButtonCheckUpdate_OnClick">
                    <Button.IsVisible>
                        <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <enums:UpdateStatus>UpToDate</enums:UpdateStatus>
                            </Binding.ConverterParameter>
                        </Binding>
                    </Button.IsVisible>
                </Button>
                <SplitButton Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.DownloadAndInstall}" Classes="accent" Margin="4"
                             Click="ButtonDownloadUpdate_OnClick">
                    <SplitButton.Flyout>
                        <MenuFlyout>
                            <MenuItem Header="{ci:Tr SettingPages.UpdateSettingsPage.Header.DownloadOnly}" Click="MenuItemDownloadOnly_OnClick"/>
                        </MenuFlyout>
                    </SplitButton.Flyout>
                    <Button.IsVisible>
                        <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <enums:UpdateStatus>UpdateAvailable</enums:UpdateStatus>
                            </Binding.ConverterParameter>
                        </Binding>
                    </Button.IsVisible>
                </SplitButton>
                <Button Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.InstallUpdates}" Classes="accent" Margin="4"
                        Click="ButtonDeployUpdate_OnClick">
                    <Button.IsVisible>
                        <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <enums:UpdateStatus>UpdateDownloaded</enums:UpdateStatus>
                            </Binding.ConverterParameter>
                        </Binding>
                    </Button.IsVisible>
                </Button>
                <Button Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.RestartAndApplyTheUpdate}" Classes="accent" Margin="4"
                        Click="ButtonRestart_OnClick">
                    <Button.IsVisible>
                        <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <enums:UpdateStatus>UpdateDeployed</enums:UpdateStatus>
                            </Binding.ConverterParameter>
                        </Binding>
                    </Button.IsVisible>
                </Button>

                <Button Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.CheckForUpdates}" Margin="4"
                        Click="ButtonCheckUpdate_OnClick">
                    <Button.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.And}">
                            <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus"
                                     Converter="{x:Static ObjectConverters.NotEqual}"
                                     ConverterParameter="{x:Static enums:UpdateStatus.UpToDate}" />
                            <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus"
                                     Converter="{x:Static ObjectConverters.NotEqual}"
                                     ConverterParameter="{x:Static enums:UpdateStatus.UpdateDeployed}" />
                        </MultiBinding>
                    </Button.IsVisible>
                </Button>
            </WrapPanel>

            <StackPanel Spacing="4">
                <StackPanel.IsVisible>
                    <Binding Path="ViewModel.UpdateService.CurrentWorkingStatus"
                             Converter="{x:Static ObjectConverters.NotEqual}">
                        <Binding.ConverterParameter>
                            <enums:UpdateWorkingStatus>Idle</enums:UpdateWorkingStatus>
                        </Binding.ConverterParameter>
                    </Binding>
                </StackPanel.IsVisible>
                <ProgressBar Maximum="{Binding ViewModel.UpdateService.DownloadingCountTotal}"
                             Value="{Binding ViewModel.UpdateService.DownloadedCount}">
                    <ProgressBar.IsIndeterminate>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="ViewModel.UpdateService.CurrentWorkingStatus"
                                     Converter="{x:Static ObjectConverters.NotEqual}">
                                <Binding.ConverterParameter>
                                    <enums:UpdateWorkingStatus>DownloadingUpdates</enums:UpdateWorkingStatus>
                                </Binding.ConverterParameter>
                            </Binding>
                            <Binding Path="ViewModel.UpdateService.IsDownloadingProgressIndeterminate"/>
                        </MultiBinding>
                    </ProgressBar.IsIndeterminate>
                </ProgressBar>
                <TextBlock Text="{Binding ViewModel.UpdateService.CurrentWorkingStatus, Converter={x:Static settingPages:UpdateSettingsPage.UpdateWorkingStatusToMessageConverter}}"/>
            </StackPanel>


            <WrapPanel Classes="animated-resize" >
                <Button Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.CheckDownloadStatus}" Margin="4"
                        Click="ButtonOpenDownloadTasks_OnClick">
                    <Button.IsVisible>
                        <Binding Path="ViewModel.UpdateService.CurrentWorkingStatus"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <enums:UpdateWorkingStatus>DownloadingUpdates</enums:UpdateWorkingStatus>
                            </Binding.ConverterParameter>
                        </Binding>
                    </Button.IsVisible>
                </Button>
                <Button Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.Cancel}" Margin="4"
                        Click="ButtonCancelDownload_OnClick">
                    <Button.IsVisible>
                        <Binding Path="ViewModel.UpdateService.CurrentWorkingStatus"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <enums:UpdateWorkingStatus>DownloadingUpdates</enums:UpdateWorkingStatus>
                            </Binding.ConverterParameter>
                        </Binding>
                    </Button.IsVisible>
                </Button>
            </WrapPanel>
            <Separator/>

            <TabControl Classes="compact"
                        ClipToBounds="False"
                        Padding="0" Margin="0">
                <TabControl.IsEnabled>
                    <Binding Path="ViewModel.UpdateService.CurrentWorkingStatus"
                             Converter="{x:Static ObjectConverters.Equal}">
                        <Binding.ConverterParameter>
                            <enums:UpdateWorkingStatus>Idle</enums:UpdateWorkingStatus>
                        </Binding.ConverterParameter>
                    </Binding>
                </TabControl.IsEnabled>
                <TabItem Header="{ci:Tr SettingPages.UpdateSettingsPage.Header.UpdateLog}">
                    <Grid >
                        <ci:Lazy>
                            <mdxaml:MarkdownScrollViewer
                                Engine="{x:Static helpers:MarkdownConvertHelper.Engine}"
                                Markdown="{Binding ViewModel.NewVersionChangeLogDocument}">
                                <mdxaml:MarkdownScrollViewer.IsVisible>
                                    <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus"
                                             Converter="{x:Static ObjectConverters.NotEqual}">
                                        <Binding.ConverterParameter>
                                            <enums:UpdateStatus>UpToDate</enums:UpdateStatus>
                                        </Binding.ConverterParameter>
                                    </Binding>
                                </mdxaml:MarkdownScrollViewer.IsVisible>
                                <mdxaml:MarkdownScrollViewer.Styles>
                                    <StyleInclude Source="avares://ClassIsland.Core/Themes/RichTextStyles.axaml" />
                                </mdxaml:MarkdownScrollViewer.Styles>
                            </mdxaml:MarkdownScrollViewer>
                        </ci:Lazy>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Spacing="8"
                                    Classes="items-halign-center"
                                    Margin="0 50">
                            <StackPanel.IsVisible>
                                <Binding Path="ViewModel.SettingsService.Settings.LastUpdateStatus"
                                         Converter="{x:Static ObjectConverters.Equal}">
                                    <Binding.ConverterParameter>
                                        <enums:UpdateStatus>UpToDate</enums:UpdateStatus>
                                    </Binding.ConverterParameter>
                                </Binding>
                            </StackPanel.IsVisible>
                            <ci:StickerControl Height="81" Width="81"
                                               StickerSource="avares://ClassIsland/Assets/HoYoStickers/光辉矢愿_遨游.png"
                                               StickerToolTip="光辉矢愿_遨游"
                                               FallbackIcon="{ci:FluentIconSource &#xE262;, FontSize=81}"/>

                            <TextBlock TextWrapping="Wrap"
                                       HorizontalAlignment="Center">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr SettingPages.UpdateSettingsPage.Text.AlreadyLatestVersionWithEasterEgg}"/>
                                    </Style>
                                    <Style Selector=":no-easter-eggs TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr SettingPages.UpdateSettingsPage.Text.UpdatedToLatestVersion}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <Button Click="ButtonShowChangeLogs_OnClick" Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.CheckTheChangelog}"/>
                        </StackPanel>
                    </Grid>
                </TabItem>
                <TabItem Header="{ci:Tr SettingPages.UpdateSettingsPage.Header.UpdateSettings}">
                    <StackPanel Margin="0" Classes="settings-container animated-intro">
                        <!-- 更新模式 -->
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xe161;}"
                                                   Header="{ci:Tr SettingPages.UpdateSettingsPage.Header.UpdateTheMode}"
                                                   Description="{ci:Tr SettingPages.UpdateSettingsPage.Description.SetTheAppSUpdateMode}">
                            <controls:FASettingsExpander.Footer>
                                <ComboBox SelectedIndex="{Binding ViewModel.SettingsService.Settings.UpdateMode}">
                                    <ComboBoxItem Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.NeverUpdatesAutomatically}"/>
                                    <ComboBoxItem Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.AutomaticallyCheckForUpdatesAndNotifyNotifications}"/>
                                    <ComboBoxItem Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.AutomaticallyChecksForUpdatesAndDownloads}"/>
                                    <ComboBoxItem Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.AutomaticallyChecksForUpdatesAndInstalls}"/>
                                </ComboBox>
                            </controls:FASettingsExpander.Footer>
                        </controls:FASettingsExpander>

                        <!-- 更新通道 -->
                        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xe3d2;}"
                                                   Header="{ci:Tr SettingPages.UpdateSettingsPage.Header.UpdateChannels}" IsExpanded="True"
                                                   Description="{ci:Tr SettingPages.UpdateSettingsPage.Description.ControlTheTargetVersionOfAppUpdatesThe}">
                            <controls:FASettingsExpander.Footer>
                                <ComboBox ItemsSource="{Binding ViewModel.UpdateService.DistributionMetadata.Channels}"
                                          SelectedValueBinding="{Binding Key}"
                                          SelectedValue="{Binding ViewModel.SettingsService.Settings.SelectedUpdateChannelV3}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Value.Name}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </controls:FASettingsExpander.Footer>
                            <controls:FASettingsExpanderItem>
                                <TextBlock Text="{Binding ViewModel.SelectedChannel.Description}" TextWrapping="Wrap"/>
                            </controls:FASettingsExpanderItem>
                            <controls:FASettingsExpanderItem Content="{ci:Tr SettingPages.UpdateSettingsPage.Content.MandatoryCheckForUpdates}"
                                                           IsClickEnabled="True"
                                                           Click="SettingsExpanderItemCheckUpdateForce_OnClick"
                                                           Description="{ci:Tr SettingPages.UpdateSettingsPage.Description.ForceTheAppToUpdateToTheLatest}"
                                                           ActionIconSource="{ci:FluentIconSource &#xe44e;}">
                            </controls:FASettingsExpanderItem>
                        </controls:FASettingsExpander>

                    </StackPanel>
                </TabItem>
                <TabItem Header="{ci:Tr SettingPages.UpdateSettingsPage.Header.DebugDebugSettings}" IsVisible="{Binding IsDevelopmentBuild, Source={x:Static ci:AppBase.Current}}">
                    <StackPanel Margin="0" Classes="settings-container animated-intro">
                        <ci:Field Label="{ci:Tr SettingPages.UpdateSettingsPage.Label.OverridePdcRootUrl}">
                            <TextBox Watermark="{ci:Tr SettingPages.UpdateSettingsPage.Watermark.LeaveBlankToDisable}" Text="{Binding ViewModel.SettingsService.Settings.DebugPhainonRootUrlOverride}"/>
                        </ci:Field>
                        <ci:Field Label="{ci:Tr SettingPages.UpdateSettingsPage.Label.OverrideSubchannel}">
                            <TextBox Watermark="{ci:Tr SettingPages.UpdateSettingsPage.Watermark.LeaveBlankToDisable}" Text="{Binding ViewModel.SettingsService.Settings.DebugSubChannelOverride}"/>
                        </ci:Field>
                        <ci:Field Label="{ci:Tr SettingPages.UpdateSettingsPage.Label.OverrideMetadataPublicKey}">
                            <TextBox Watermark="{ci:Tr SettingPages.UpdateSettingsPage.Watermark.LeaveBlankToDisable}" Text="{Binding ViewModel.SettingsService.Settings.DebugPublicKeyOverride}"
                                     AcceptsReturn="True"/>
                        </ci:Field>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
