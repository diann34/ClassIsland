<ci:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.ManagementPolicySettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="ManagementPolicySettingsPage_OnLoaded"
      Unloaded="ManagementPolicySettingsPage_OnUnloaded"
      d:DataContext="{d:DesignInstance local:ManagementPolicySettingsPage}">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro" IsEnabled="{Binding ViewModel.IsLocked, Converter={StaticResource InvertBooleanConverter}}">
            <controls:FAInfoBar Message="{ci:Tr SettingPages.ManagementPolicySettingsPage.Message.SomePolicySettingsMayRequireARestartTo}"
                              IsClosable="False"
                              IsOpen="True">
                <controls:FAInfoBar.ActionButton>
                    <Button DockPanel.Dock="Right"
                            Foreground="{DynamicResource MaterialDesignBody}"
                            Click="ButtonRestart_OnClick">
                        <ci:IconText Glyph="&#xe0bd;" Text="{ci:Tr SettingPages.ManagementPolicySettingsPage.Text.RestartApplication}"/>
                    </Button>
                </controls:FAInfoBar.ActionButton>
            </controls:FAInfoBar>

            <ci:IconText Glyph="&#xe699;" Text="{ci:Tr SettingPages.ManagementPolicySettingsPage.Text.Archives}" Margin="0 0 0 4" />
            <!-- 禁止编辑档案 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xe6bb;}"
                                       Header="{ci:Tr SettingPages.ManagementPolicySettingsPage.Header.EditingArchivesIsProhibited}"
                                       Description="{ci:Tr SettingPages.ManagementPolicySettingsPage.Description.AfterEnablingThisUsersWillNotBeAble3}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ManagementService.Policy.DisableProfileEditing, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <!-- 禁止修改课表 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xe6b1;}"
                                       Header="{ci:Tr SettingPages.ManagementPolicySettingsPage.Header.EditingClassSchedulesIsProhibited}"
                                       Description="{ci:Tr SettingPages.ManagementPolicySettingsPage.Description.AfterEnablingThisOptionUsersWillNotBe}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ManagementService.Policy.DisableProfileClassPlanEditing, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <!-- 禁止编辑时间表 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xf0eb;}"
                                       Header="{ci:Tr SettingPages.ManagementPolicySettingsPage.Header.EditingSchedulesIsProhibited}"
                                       Description="{ci:Tr SettingPages.ManagementPolicySettingsPage.Description.AfterEnablingThisUsersWillNotBeAble}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ManagementService.Policy.DisableProfileTimeLayoutEditing, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <!-- 禁止编辑科目 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xe47a;}"
                                       Header="{ci:Tr SettingPages.ManagementPolicySettingsPage.Header.EditingSubjectsIsProhibited}"
                                       Description="{ci:Tr SettingPages.ManagementPolicySettingsPage.Description.AfterEnablingThisUsersWillNotBeAble2}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ManagementService.Policy.DisableProfileSubjectsEditing, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <ci:IconText Glyph="&#xef27;" Text="{ci:Tr SettingPages.ManagementPolicySettingsPage.Text.ApplicationSettings}" Margin="0 0 0 4" />

            <!-- 禁止编辑应用设置 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xef27;}"
                                       Header="{ci:Tr SettingPages.ManagementPolicySettingsPage.Header.EditingAppSettingsIsProhibited}"
                                       Description="{ci:Tr SettingPages.ManagementPolicySettingsPage.Description.AfterEnablingThisUsersWillNotBeAble5}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ManagementService.Policy.DisableSettingsEditing, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <!-- 禁止自定义启动加载界面 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEea1;}"
                                       Header="{ci:Tr SettingPages.ManagementPolicySettingsPage.Header.DisableCustomStartupLoadingInterfaces}"
                                       Description="{ci:Tr SettingPages.ManagementPolicySettingsPage.Description.AfterEnablingThisUsersWillNotBeAble4}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ManagementService.Policy.DisableSplashCustomize, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <!-- 禁用调试菜单 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xe2c8;}"
                                       Header="{ci:Tr SettingPages.ManagementPolicySettingsPage.Header.DisableTheDebugMenu}"
                                       Description="{ci:Tr SettingPages.ManagementPolicySettingsPage.Description.AfterEnablingThisUsersWillNotBeAble6}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ManagementService.Policy.DisableDebugMenu, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <ci:IconText Glyph="&#xebaa;" Text="{ci:Tr SettingPages.ManagementPolicySettingsPage.Text.Miscellaneous}" Margin="0 0 0 4" />

            <!-- 允许退出集控 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xe2b8;}"
                                       Header="{ci:Tr SettingPages.ManagementPolicySettingsPage.Header.AllowsExitFromCentralizedControl}"
                                       Description="{ci:Tr SettingPages.ManagementPolicySettingsPage.Description.ControlWhetherUsersCanVoluntarilyExitCentralizedControl}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ManagementService.Policy.AllowExitManagement, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
            <!-- 禁用彩蛋 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xe7eb;}"
                                       Header="{ci:Tr SettingPages.ManagementPolicySettingsPage.Header.BanEasterEggs}"
                                       Description="{ci:Tr SettingPages.ManagementPolicySettingsPage.Description.AfterEnablingThisEasterEggsInTheInterface}">
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ManagementService.Policy.DisableEasterEggs, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
