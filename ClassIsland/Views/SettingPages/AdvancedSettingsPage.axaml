<ci:SettingsPageBase xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:settingPages="clr-namespace:ClassIsland.Views.SettingPages"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Views.SettingPages.AdvancedSettingsPage"
             d:DataContext="{d:DesignInstance settingPages:AdvancedSettingsPage}">
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <controls:FAInfoBar Severity="Warning"
                              Title="{ci:Tr SettingPages.AdvancedSettingsPage.Title.BeCareful}" IsClosable="False"
                              Message="{ci:Tr SettingPages.AdvancedSettingsPage.Message.ModifyingTheSettingsOnThisPageCarriesRisks}"
                              IsOpen="True"/>
            <!-- 自动禁用异常插件 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE073;}"
                                        Header="{ci:Tr SettingPages.AdvancedSettingsPage.Header.AutomaticallyDisableAbnormalPlugins}"
                                        Description="{ci:Tr SettingPages.AdvancedSettingsPage.Description.WhenEnabledClassIslandWillAutomaticallyDisablePluginsTha}"
                                        >
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.AutoDisableCorruptPlugins, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <!-- 渲染模式 -->
            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE62F;}"
                                        Header="{ci:Tr SettingPages.AdvancedSettingsPage.Header.RenderingMode}"
                                        Description="{ci:Tr SettingPages.AdvancedSettingsPage.Description.WhenRenderingTheUITheRenderingModeSpecified}"
            >
                <controls:FASettingsExpander.IsVisible>
                    <OnPlatform Default="False">
                        <On Options="Windows" Content="True"/>
                    </OnPlatform>
                </controls:FASettingsExpander.IsVisible>
                <controls:FASettingsExpander.Footer>
                    <ComboBox SelectedIndex="{Binding ViewModel.RenderingModeSelectedIndex}">
                        <ComboBoxItem>{ci:Tr SettingPages.AdvancedSettingsPage.Content.Default}</ComboBoxItem>
                        <ComboBoxItem>{ci:Tr SettingPages.AdvancedSettingsPage.Content.SoftwareNotRecommended}</ComboBoxItem>
                        <ComboBoxItem>AngleEgl</ComboBoxItem>
                        <ComboBoxItem>Wgl</ComboBoxItem>
                        <ComboBoxItem>Vulkan</ComboBoxItem>
                    </ComboBox>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>

            <Panel IsVisible="{Binding Platform, Source={x:Static ci:AppBase.Current}, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter='arm64'}">
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF483;}"
                                           Header="{ci:Tr SettingPages.AdvancedSettingsPage.Header.UseTheSystemTitleBar}"
                                           Description="{ci:Tr SettingPages.AdvancedSettingsPage.Description.AfterEnabledTheAppWindowWillUseThe}">
                    <controls:FASettingsExpander.IsVisible>
                        <OnPlatform Default="False">
                            <On Options="Windows" Content="True" />
                        </OnPlatform>
                    </controls:FASettingsExpander.IsVisible>
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.UseNativeTitlebar, Mode=TwoWay}" />
                    </controls:FASettingsExpander.Footer>
                </controls:FASettingsExpander>
            </Panel>

            <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF4D1;}"
                                        Header="{ci:Tr SettingPages.AdvancedSettingsPage.Header.CompatibleWithScalingMode}"
                                        Description="{ci:Tr SettingPages.AdvancedSettingsPage.Description.OnceEnabledTheAppIgnoresScalingSettingsProvided}">
                <controls:FASettingsExpander.IsVisible>
                    <OnPlatform Default="False">
                        <On Options="Linux" Content="True"/>
                    </OnPlatform>
                </controls:FASettingsExpander.IsVisible>
                <controls:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.IgnoreQtScaling, Mode=TwoWay}"/>
                </controls:FASettingsExpander.Footer>
            </controls:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
