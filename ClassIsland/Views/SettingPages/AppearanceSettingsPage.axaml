<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.AppearanceSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:converters="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
      xmlns:controls2="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      xmlns:settingsPages="clr-namespace:ClassIsland.ViewModels.SettingsPages"
      xmlns:classIsland="clr-namespace:ClassIsland"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      mc:Ignorable="d"
      d:DesignHeight="450" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:AppearanceSettingsPage}">

    <controls:SettingsPageBase.Resources>
        <converters:ColorToColorPickerBrushConverter x:Key="ColorToColorPickerBrushConverter" />
    </controls:SettingsPageBase.Resources>
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <controls1:IconText Glyph="&#xEF27;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.Basic}" Margin="0 0 0 4" />
            <!-- 界面缩放 -->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xF4D1;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.InterfaceScaling}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.ZoomingInAndOutOfTheMainInterface}">
                <controls2:FASettingsExpander.Footer>
                    <Slider Width="180" Minimum="0.75" Maximum="2.5"
                            VerticalAlignment="Center"
                            Classes="auto-tooltip"
                            ci:SliderDragTooltipAssist.StringFormat="F2"
                            Value="{Binding ViewModel.SettingsService.Settings.Scale}"
                            TickFrequency="0.05"
                            TickPlacement="None"
                            IsSnapToTickEnabled="True"/>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>

            <!--背景颜色-->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xE523;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.BackgroundColor}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.HomeInterfaceBackgroundColorWhenDisabledTheColor}">
                <controls2:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal">

                        <ColorPicker
                            VerticalAlignment="Center"
                            Margin="0 0 6 0"
                            Color="{Binding ViewModel.SettingsService.Settings.BackgroundColor, Mode=TwoWay}"
                            IsVisible="{Binding ViewModel.SettingsService.Settings.IsCustomBackgroundColorEnabled}"/>
                        <ToggleSwitch VerticalAlignment="Center"
                                      IsChecked="{Binding ViewModel.SettingsService.Settings.IsCustomBackgroundColorEnabled}" />
                    </StackPanel>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>

            <!-- 背景不透明度 -->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xF37D;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.BackgroundOpacity}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.OpacityOfTheMainInterfaceBackground}">
                <controls2:FASettingsExpander.Footer>
                    <Slider Width="180" Minimum="0" Maximum="1"
                            Classes="auto-tooltip"
                            ci:SliderDragTooltipAssist.StringFormat="F2"
                            Value="{Binding ViewModel.SettingsService.Settings.Opacity}"
                            TickFrequency="0.05"
                            IsSnapToTickEnabled="True"/>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>

            <!-- 圆角半径 -->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xF031;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.CornerRadius}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.MainInterfaceFilletRadiusWhenSetToThe}">
                <controls2:FASettingsExpander.Footer>
                    <Slider Grid.Row="0" Width="180" Minimum="0" Maximum="20"
                            Value="{Binding ViewModel.SettingsService.Settings.RadiusX}"
                            TickFrequency="0.5"
                            ci:SliderDragTooltipAssist.StringFormat="F1"
                            Classes="auto-tooltip"
                            IsSnapToTickEnabled="True"
                            VerticalAlignment="Center"/>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>

            <!-- 行间隔 -->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xE6EF;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.RowSpacing}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.LineSpacingOnTheMainInterface}">
                <controls2:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal">
                        <Slider Width="130" Minimum="0" Maximum="150"
                                Value="{Binding ViewModel.SettingsService.Settings.MainWindowLineVerticalMargin}"
                                TickFrequency="5"
                                ci:SliderDragTooltipAssist.StringFormat="F1"
                                Classes="auto-tooltip"
                                VerticalAlignment="Center"
                                IsSnapToTickEnabled="True"/>
                        <NumericUpDown
                            Value="{Binding ViewModel.SettingsService.Settings.MainWindowLineVerticalMargin, Converter={x:Static ci:NotNaNConverter.Instance}}"
                            Margin="6,0,0,0"
                            Minimum="0"
                            Width="125"/>
                    </StackPanel>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>

            <!-- 分体主界面 -->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xf023;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.SplitMainInterface}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.AfterActivationTheComponentWillBeSeparated}">
                <controls2:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsIslandSeperated}"/>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>

            <Separator Margin="0 12 0 4" />
            <controls1:IconText Glyph="&#xE51E;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.Theme}" Margin="0 0 0 4" />
            <!-- 应用主题 -->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xE5CB;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.ApplicationThemes}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.ControlTheLightAndDarkThemesOfThe}">
                <controls2:FASettingsExpander.Footer>
                    <ComboBox Foreground="{DynamicResource MaterialDesignBody}"
                              SelectedIndex="{Binding ViewModel.SettingsService.Settings.Theme}"
                              HorizontalContentAlignment="Left">
                        <controls1:IconText Glyph="&#xE5CB;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.FollowTheSystem}" />
                        <controls1:IconText Glyph="&#xF465;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.Bright}" />
                        <controls1:IconText Glyph="&#xF44B;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.Darkness}" />
                    </ComboBox>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>

            <!-- 主题色来源 -->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xEC50;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.SourceOfThemeColors}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.ControlTheWayTheAppSelectsTheTheme}">
                <controls2:FASettingsExpander.Footer>
                    <ComboBox Foreground="{DynamicResource MaterialDesignBody}"
                              SelectionChanged="ButtonUpdateWallpaper_OnClick"
                              HorizontalContentAlignment="Left"
                              SelectedIndex="{Binding ViewModel.SettingsService.Settings.ColorSource}">
                        <ComboBoxItem>
                            <controls1:IconText Glyph="&#xED39;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.Customizable}" />
                        </ComboBoxItem>
                        <ComboBoxItem IsVisible="False" IsEnabled="False">
                            <controls1:IconText Glyph="&#xF42D;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.SystemWallpaper}" />
                        </ComboBoxItem>
                        <ComboBoxItem>
                            <controls1:IconText Glyph="&#xEA1D;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.System}" />
                        </ComboBoxItem>
                        <ComboBoxItem IsVisible="False" IsEnabled="False">
                            <controls1:IconText Glyph="&#xEEED;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.ScreenThemeColors}"/>
                        </ComboBoxItem>
                    </ComboBox>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>

            <StackPanel>
                <!-- todo: 仅在使用自定义主题色时显示 -->
                <!-- 第一主题色 -->
                <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xE51E;}"
                                            Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.AccentColors}"
                                            Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.ApplyTheColorsUsedWhenDisplayingHighlightedElements}">
                    <controls2:FASettingsExpander.IsVisible>
                        <Binding Path="ViewModel.SettingsService.Settings.ColorSource"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <system:Int32>0</system:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls2:FASettingsExpander.IsVisible>
                    <controls2:FASettingsExpander.Footer>
                        <ColorPicker
                            Color="{Binding ViewModel.SettingsService.Settings.PrimaryColor, Mode=TwoWay}" />
                    </controls2:FASettingsExpander.Footer>
                </controls2:FASettingsExpander>

            </StackPanel>
            <!-- 壁纸主题色 -->
            <!-- <StackPanel> -->
