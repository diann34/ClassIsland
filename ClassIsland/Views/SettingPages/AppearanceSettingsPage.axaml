            <Separator Margin="0 16 0 8" />
            <controls1:IconText Glyph="&#xF26F;" Text="{ci:Tr SettingPages.AppearanceSettingsPage.Text.Font}" Margin="0 0 0 8" />
            <controls2:FASettingsExpander Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.CustomFonts}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.CustomizeTheFontForTheClassScheduleDisplayed}"
                                        IconSource="{controls1:FluentIconSource &#xF271;}">
                <controls2:FASettingsExpander.Footer>
                    <ComboBox x:Name="FontComboBox"
                              ItemsSource="{Binding ViewModel.FontFamilies}"
                              Foreground="{DynamicResource MaterialDesignBody}"
                              MaxDropDownHeight="360"
                              SelectedItem="{Binding ViewModel.SettingsService.Settings.MainWindowFont, Converter={StaticResource StringToFontFamilyConverter}, ConverterParameter=UseSharedDefault}"
                              HorizontalAlignment="Left">
                        <ComboBox.Styles>
                            <Style Selector="ComboBoxItem">
                                <Setter Property="MinHeight" Value="32"/>
                                <Setter Property="VerticalContentAlignment" Value="Center"/>
                            </Style>
                            <Style Selector="#FontComboBox /template/ Popup#PART_Popup">
                                <Setter Property="Width" Value="280"/>
                                <Setter Property="Placement" Value="BottomEdgeAlignedRight"/>
                            </Style>
                        </ComboBox.Styles>
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock FontFamily="{Binding}" FontWeight="Normal"
                                           ToolTip.Tip="{Binding Name}"
                                           MaxWidth="240"
                                           Height="20"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center"
                                           Classes.DefaultFont="{Binding Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static classIsland:MainWindow.DefaultFontFamily}}">
                                    <TextBlock.Styles>
                                        <Style Selector="TextBlock">
                                            <Style Selector="^.DefaultFont">
                                                <Setter Property="Text" Value="{ci:Tr SettingPages.AppearanceSettingsPage.Text.DefaultHarmonyOsSansSc}"/>
                                            </Style>
                                            <Setter Property="Text" Value="{Binding }" />
                                        </Style>
                                    </TextBlock.Styles>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xF26F;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.CustomFontWeight}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.CustomizeTheFontWeightDisplayedOnTheMain}">
                <controls2:FASettingsExpander.Footer>
                    <ComboBox
                        SelectedItem="{Binding ViewModel.SettingsService.Settings.MainWindowFontWeight2, Converter={StaticResource IntToFontWeightConverter}}"
                        Foreground="{DynamicResource MaterialDesignBody}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="{Binding}"
                                           ToolTip.Tip="{Binding}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                        <x:Static Member="FontWeight.Thin" />
                        <!--<x:Static Member="FontWeights.UltraLight"/>-->
                        <x:Static Member="FontWeight.ExtraLight" />
                        <x:Static Member="FontWeight.Light" />
                        <x:Static Member="FontWeight.Normal" />
                        <!--<x:Static Member="FontWeights.Regular"/>-->
                        <x:Static Member="FontWeight.Medium" />
                        <!--<x:Static Member="FontWeights.DemiBold"/>-->
                        <x:Static Member="FontWeight.SemiBold" />
                        <x:Static Member="FontWeight.Bold" />
                        <x:Static Member="FontWeight.ExtraBold" />
                        <!--<x:Static Member="FontWeights.UltraBold"/>-->
                        <x:Static Member="FontWeight.Black" />
                        <!--<x:Static Member="FontWeights.Heavy"/>-->
                        <x:Static Member="FontWeight.ExtraBlack" />
                        <!--<x:Static Member="FontWeights.UltraBlack"/>-->
                    </ComboBox>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>
            <!-- 字体大小 -->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xF273;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.FontSize}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.AdjustTheFontSizesOnTheMainInterface}">
                <controls2:FASettingsExpander.Styles>
                    <Style Selector="controls1|Field">
                        <Setter Property="Width" Value="175"/>
                        <Setter Property="Suffix" Value="px"/>
                        <Style Selector="^ controls2|FANumberBox">
                            <Setter Property="SpinButtonPlacementMode" Value="Inline"/>
                            <Setter Property="Minimum" Value="1"/>
                            <Setter Property="Maximum" Value="40"/>
                            <Setter Property="HorizontalAlignment" Value="Stretch"/>
                        </Style>
                    </Style>
                </controls2:FASettingsExpander.Styles>
                <controls2:FASettingsExpanderItem Content="{ci:Tr SettingPages.AppearanceSettingsPage.Content.SecondaryFontSize}"
                                                Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.AdditionalInformationAtTimePointsEtc}">

                    <controls2:FASettingsExpanderItem.Footer>
                        <controls1:Field>
                            <controls2:FANumberBox Value="{Binding ViewModel.SettingsService.Settings.MainWindowSecondaryFontSize, Converter={x:Static ci:NotNaNConverter.Instance}}"/>
                        </controls1:Field>
                    </controls2:FASettingsExpanderItem.Footer>
                </controls2:FASettingsExpanderItem>
                <controls2:FASettingsExpanderItem Content="{ci:Tr SettingPages.AppearanceSettingsPage.Content.BodyFontSize}"
                                                Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.DefaultFontSizeOnTheMainInterface}">

                    <controls2:FASettingsExpanderItem.Footer>
                        <controls1:Field>
                            <controls2:FANumberBox Value="{Binding ViewModel.SettingsService.Settings.MainWindowBodyFontSize, Converter={x:Static ci:NotNaNConverter.Instance}}"/>
                        </controls1:Field>
                    </controls2:FASettingsExpanderItem.Footer>
                </controls2:FASettingsExpanderItem>
                <controls2:FASettingsExpanderItem Content="{ci:Tr SettingPages.AppearanceSettingsPage.Content.EmphasizeFontSize}"
                                                Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.ContentSuchAsTimetableClockReminderTitlesWeather}">

                    <controls2:FASettingsExpanderItem.Footer>
                        <controls1:Field>
                            <controls2:FANumberBox Value="{Binding ViewModel.SettingsService.Settings.MainWindowEmphasizedFontSize, Converter={x:Static ci:NotNaNConverter.Instance}}"/>
                        </controls1:Field>
                    </controls2:FASettingsExpanderItem.Footer>
                </controls2:FASettingsExpanderItem>
                <controls2:FASettingsExpanderItem Content="{ci:Tr SettingPages.AppearanceSettingsPage.Content.LargeFontSize}"
                                                Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.ContentSuchAsCourseForecastEtc}">

                    <controls2:FASettingsExpanderItem.Footer>
                        <controls1:Field>
                            <controls2:FANumberBox Value="{Binding ViewModel.SettingsService.Settings.MainWindowLargeFontSize, Converter={x:Static ci:NotNaNConverter.Instance}}"/>
                        </controls1:Field>
                    </controls2:FASettingsExpanderItem.Footer>
                </controls2:FASettingsExpanderItem>
            </controls2:FASettingsExpander>

            <!-- 字体颜色 -->
            <controls2:FASettingsExpander IconSource="{controls1:FluentIconSource &#xF22A;}"
                                        Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.FontColor}"
                                        Description="{ci:Tr SettingPages.AppearanceSettingsPage.Description.AdjustTheFontColorToOverrideTheTheme}">
                <controls2:FASettingsExpander.Footer>
                    <StackPanel Orientation="Horizontal">

                        <ColorPicker
                            VerticalAlignment="Center"
                            Margin="0 0 6 0"
                            Color="{Binding ViewModel.SettingsService.Settings.CustomForegroundColor, Mode=TwoWay}"
                            IsVisible="{Binding ViewModel.SettingsService.Settings.IsCustomForegroundColorEnabled}"/>
                        <ToggleSwitch VerticalAlignment="Center"
                                      IsChecked="{Binding ViewModel.SettingsService.Settings.IsCustomForegroundColorEnabled}" />
                    </StackPanel>
                </controls2:FASettingsExpander.Footer>
            </controls2:FASettingsExpander>
            <!-- 字体预览 -->
            <TabControl Classes="compact" Padding="0">
                <TabItem Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.FontPreview}">
                    <TextBox
                        FontWeight="{Binding ViewModel.SettingsService.Settings.MainWindowFontWeight2, Converter={StaticResource IntToFontWeightConverter}}"
                        FontSize="17"
                        Padding="8"
                        IsReadOnly="False"
                        AcceptsReturn="True"
                        FontFamily="{Binding ViewModel.SettingsService.Settings.MainWindowFont, Mode=OneWay, Converter={StaticResource StringToFontFamilyConverter}}"
                        Margin="0 4 0 0"
                        TextAlignment="Center"
                        xml:space="preserve">{ci:Tr SettingPages.AppearanceSettingsPage.Content.WhenOneDayYouNoLongerDwellOn}</TextBox>
                </TabItem>
                <TabItem Header="{ci:Tr SettingPages.AppearanceSettingsPage.Header.FontSizePreview}">
                    <StackPanel Spacing="2">
                        <controls1:Field Label="{ci:Tr SettingPages.AppearanceSettingsPage.Label.TestText}">
                            <TextBox Text="{Binding ViewModel.FontSizeTestText}"/>
                        </controls1:Field>
                        <TextBlock TextWrapping="Wrap"
                                   FontFamily="{Binding ViewModel.SettingsService.Settings.MainWindowFont, Mode=OneWay, Converter={StaticResource StringToFontFamilyConverter}}"
                                   FontWeight="{Binding ViewModel.SettingsService.Settings.MainWindowFontWeight2, Converter={StaticResource IntToFontWeightConverter}}">
                            <Run Text="{Binding ViewModel.FontSizeTestText}"
                                 FontSize="{Binding ViewModel.SettingsService.Settings.MainWindowSecondaryFontSize}" />
                            <LineBreak />
                            <Run Text="{Binding ViewModel.FontSizeTestText}"
                                 FontSize="{Binding ViewModel.SettingsService.Settings.MainWindowBodyFontSize}" />
                            <LineBreak />
                            <Run Text="{Binding ViewModel.FontSizeTestText}"
                                 FontSize="{Binding ViewModel.SettingsService.Settings.MainWindowEmphasizedFontSize}" />
                            <LineBreak />
                            <Run Text="{Binding ViewModel.FontSizeTestText}"
                                 FontSize="{Binding ViewModel.SettingsService.Settings.MainWindowLargeFontSize}" />
                        </TextBlock>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
