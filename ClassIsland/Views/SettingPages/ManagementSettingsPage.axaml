<ci:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.ManagementSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
      xmlns:classIsland="clr-namespace:ClassIsland"
      xmlns:controls="clr-namespace:ClassIsland.Controls"
      xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance local:ManagementSettingsPage}"
      d:DesignHeight="450" d:DesignWidth="800"
      Loaded="ManagementSettingsPage_OnLoaded">

    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <StackPanel Classes="cardContainer">
                <controls1:FASettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{ci:Tr SettingPages.ManagementSettingsPage.Text.CentralizedControl}" FontWeight="Bold"/>

                        <StackPanel>
                            <TextBlock  TextWrapping="Wrap">
                                <Run>{ci:Tr SettingPages.ManagementSettingsPage.Content.SchoolOrganizationalItCanCentrallyDistributeSchedulesSch}</Run>
                            </TextBlock>
                            <TextBlock  TextWrapping="Wrap" Margin="0 6 0 0" IsVisible="{Binding ManagementService.IsManagementEnabled}">
                                <Run>{ci:Tr SettingPages.ManagementSettingsPage.Content.YouAreCurrentlyAffected}</Run>
                                <Run Text="{Binding ManagementService.Manifest.OrganizationName}"/>
                                <Run>{ci:Tr SettingPages.ManagementSettingsPage.Content.Management}</Run>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </controls1:FASettingsExpanderItem>
                <controls1:FASettingsExpanderItem Click="ButtonJoinManagement_OnClick"
                                                IsClickEnabled="True"
                                                IsVisible="{Binding !ManagementService.IsManagementEnabled}">
                    <Grid>
                        <TextBlock Text="{ci:Tr SettingPages.ManagementSettingsPage.Text.JoinManagement}" />
                    </Grid>
                </controls1:FASettingsExpanderItem>
                <controls1:FASettingsExpanderItem Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                                IsClickEnabled="True"
                                                ActionIconSource="{ci:FluentIconSource &#xEC2E;}"
                                                CommandParameter="https://docs.classisland.tech/management/">
                    <Grid>
                        <TextBlock Text="{ci:Tr SettingPages.ManagementSettingsPage.Text.LearnMore}" />
                    </Grid>
                </controls1:FASettingsExpanderItem>
            </StackPanel>

            <StackPanel Classes="cardContainer"
                        IsVisible="{Binding !ManagementService.IsManagementEnabled}">
                <controls1:FASettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{ci:Tr SettingPages.ManagementSettingsPage.Text.Management}" FontWeight="Bold"/>

                        <StackPanel>
                            <TextBlock  TextWrapping="Wrap">
                                <Run>{ci:Tr SettingPages.ManagementSettingsPage.Content.YouCanAdjustSomeOfYourAppS}</Run>
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>
                </controls1:FASettingsExpanderItem>
                <controls1:FASettingsExpanderItem Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                                IsClickEnabled="True"
                                                CommandParameter="classisland://app/settings/management.credentials?ci_keepHistory=true">
                    <Grid>
                        <TextBlock Text="{ci:Tr SettingPages.ManagementSettingsPage.Text.PasswordProtectionSettings}" />
                    </Grid>
                </controls1:FASettingsExpanderItem>
                <controls1:FASettingsExpanderItem Command="{x:Static ci:UriNavigationCommands.UriNavigationCommand}"
                                                IsClickEnabled="True"
                                                CommandParameter="classisland://app/settings/management.policy?ci_keepHistory=true">
                    <Grid>
                        <TextBlock Text="{ci:Tr SettingPages.ManagementSettingsPage.Text.LimitingStrategy}" />
                    </Grid>
                </controls1:FASettingsExpanderItem>
            </StackPanel>

            <StackPanel Classes="cardContainer">
                <controls1:FASettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{ci:Tr SettingPages.ManagementSettingsPage.Text.ClientInformation}" FontWeight="Bold"/>
                    </StackPanel>
                </controls1:FASettingsExpanderItem>
                <controls1:FASettingsExpanderItem>
                    <TextBlock TextWrapping="Wrap">
                        <Run>CUID：</Run><Run Text="{Binding ManagementService.Persist.ClientUniqueId}" />
                    </TextBlock>
                </controls1:FASettingsExpanderItem>
                <controls1:FASettingsExpanderItem
                    IsVisible="{Binding ManagementService.IsManagementEnabled}">
                    <TextBlock TextWrapping="Wrap">
                        <Run>ID：</Run><Run Text="{Binding ManagementService.Settings.ClassIdentity}" />
                    </TextBlock>
                </controls1:FASettingsExpanderItem>
            </StackPanel>

            <StackPanel Classes="cardContainer"
                        IsVisible="{Binding ManagementService.IsManagementEnabled}">
                <controls1:FASettingsExpanderItem>
                    <StackPanel Spacing="8">
                        <TextBlock Text="{ci:Tr SettingPages.ManagementSettingsPage.Text.ServerSideInformation}" FontWeight="Bold"/>
                    </StackPanel>
                </controls1:FASettingsExpanderItem>
                <controls1:FASettingsExpanderItem>
                    <TextBlock TextWrapping="Wrap">
                        <Run>{ci:Tr SettingPages.ManagementSettingsPage.Content.ServerType}</Run><Run Text="{Binding ManagementService.Manifest.ServerKind}"/>
                    </TextBlock>
                </controls1:FASettingsExpanderItem>
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</ci:SettingsPageBase>
