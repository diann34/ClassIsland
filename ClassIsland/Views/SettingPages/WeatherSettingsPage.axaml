<controls:SettingsPageBase x:Class="ClassIsland.Views.SettingPages.WeatherSettingsPage"
      xmlns="https://github.com/avaloniaui"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:ClassIsland.Views.SettingPages"
      xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
      xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
      xmlns:controls2="clr-namespace:ClassIsland.Controls"
      xmlns:converters="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
      xmlns:ci="http://classisland.tech/schemas/xaml/core"
      xmlns:controls3="using:FluentAvalonia.UI.Controls"
      xmlns:system="clr-namespace:System;assembly=System.Runtime"
      xmlns:asyncImageLoader="clr-namespace:AsyncImageLoader;assembly=AsyncImageLoader.Avalonia"
      xmlns:abstraction="clr-namespace:ClassIsland.Platforms.Abstraction;assembly=ClassIsland.Platforms.Abstractions"
      xmlns:services="clr-namespace:ClassIsland.Core.Abstractions.Services;assembly=ClassIsland.Core"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      d:DataContext="{d:DesignInstance local:WeatherSettingsPage}"
      Loaded="WeatherSettingsPage_OnLoaded"
      Unloaded="WeatherSettingsPage_OnUnloaded">

    <controls:SettingsPageBase.Resources>
        <converters:CollectionToStringConverter x:Key="CollectionToStringConverter" />
        <converters:PreventNullConverter x:Key="PreventNullConverter" />
        <Grid Width="320" Margin="16" x:Key="CitySearcher" RowDefinitions="Auto,*">
            <StackPanel Grid.Row="0" Spacing="8">
                <TextBlock Text="{ci:Tr SettingPages.WeatherSettingsPage.Text.SearchCity}" Theme="{StaticResource SubtitleTextBlockStyle}" />
                <Grid>
                    <TextBox TextChanged="TextBoxSearchCity_OnTextChanged"
                             Watermark="{ci:Tr SettingPages.WeatherSettingsPage.Watermark.SearchCityOrProvince}"
                             x:Name="TextBoxSearchCity" />
                    <controls3:FAProgressRing
                          IsIndeterminate="True"
                          HorizontalAlignment="Right"
                          Margin="0 0 4 0"
                          VerticalAlignment="Center"
                          Height="24" Width="24"
                          IsHitTestVisible="False"
                          IsVisible="{Binding ViewModel.IsSearchingWeather}" />
                </Grid>
            </StackPanel>
            <!-- Main list box -->
            <ListBox Grid.Row="1"
                     Margin="0 8 0 0"
                     SelectedValueBinding="{Binding CityId}"
                     SelectedValue="{Binding ViewModel.SettingsService.Settings.CityId}"
                     ItemsSource="{Binding ViewModel.CitySearchResults}"
                     SelectionMode="Single"
                     SelectionChanged="SelectorCity_OnSelectionChanged"
                     AutoScrollToSelectedItem="True">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <RadioButton Content="{Binding Name}"
                                     IsChecked="{Binding IsSelected, RelativeSource={RelativeSource FindAncestor, AncestorType=ListBoxItem}}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <!-- 无结果 -->
            <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0 50"
                        IsVisible="{Binding !!!ViewModel.CitySearchResults.Count}">
                <ci:Empty Text="{ci:Tr SettingPages.WeatherSettingsPage.Text.NoCityMatchingTheCriteriaWasFoundPlease}" />
            </StackPanel>
        </Grid>
    </controls:SettingsPageBase.Resources>
    <ScrollViewer>
        <StackPanel Classes="settings-container animated-intro">
            <controls1:IconText Glyph="&#xF464;" Text="{ci:Tr SettingPages.WeatherSettingsPage.Text.WeatherPreview}" Margin="0 0 0 8" />
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Padding="20"
                    CornerRadius="12"
                    Margin="0 0 0 4">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14">
                            <controls2:WeatherPackIconControl MinWidth="52" MaxWidth="120" Height="52"
                                                              Code="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.Current.Weather}"
                                                              VerticalAlignment="Center" />
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock FontSize="32" FontWeight="SemiBold">
                                    <Run Text="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.Current.Temperature.Value}" />
                                    <Run Text="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.Current.Temperature.Unit}" FontSize="18" />
                                </TextBlock>
                                <TextBlock Classes="l-instructive"
                                           FontSize="12"
                                           Opacity="0.6"
                                           Text="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.UpdateTime, StringFormat={ci:Tr SettingPages.WeatherSettingsPage.Format.UpdatedAt}}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center"
                                    Orientation="Horizontal" Spacing="28">
                            <StackPanel Spacing="4">
                                <TextBlock Text="{ci:Tr SettingPages.WeatherSettingsPage.Text.Humidity}" Classes="l-instructive" HorizontalAlignment="Center" FontSize="12" Opacity="0.8" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                    <ci:FluentIcon Glyph="&#xE794;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" FontWeight="Medium">
                                        <Run Text="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.Current.Humidity.Value}" />
                                        <Run Text="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.Current.Humidity.Unit}" FontSize="10" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{ci:Tr SettingPages.WeatherSettingsPage.Text.AirQuality}" Classes="l-instructive" HorizontalAlignment="Center" FontSize="12" Opacity="0.8" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                    <ci:FluentIcon Glyph="&#xEA7D;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.Aqi.Aqi}" VerticalAlignment="Center" FontWeight="Medium" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel Spacing="4">
                                <TextBlock Text="{ci:Tr SettingPages.WeatherSettingsPage.Text.WindPower}" Classes="l-instructive" HorizontalAlignment="Center" FontSize="12" Opacity="0.8" />
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
                                    <ci:FluentIcon Glyph="&#xF43B;" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock VerticalAlignment="Center" FontWeight="Medium">
                                        <Run Text="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.Current.Wind.Speed.Value}" />
                                        <Run Text="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.Current.Wind.Speed.Unit}" FontSize="10" />
                                    </TextBlock>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                        <Grid Grid.Column="2" VerticalAlignment="Center">
                            <Button Content="{ci:FluentIcon &#xE0B5;}"
                                    ToolTip.Tip="{ci:Tr SettingPages.WeatherSettingsPage.ToolTip.Refresh}"
                                    Width="40" Height="40"
                                    Theme="{StaticResource TransparentButton}"
                                    Click="ButtonRefreshWeather_OnClick"
                                    IsVisible="{Binding !ViewModel.IsRefreshingWeather}" />
                            <controls3:FAProgressRing Width="40" Height="40"
                                                  IsIndeterminate="True"
                                                  IsVisible="{Binding ViewModel.IsRefreshingWeather}" />
                        </Grid>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding ViewModel.SettingsService.Settings.LastWeatherInfo.Alerts}"
                                  IsVisible="{Binding !!ViewModel.SettingsService.Settings.LastWeatherInfo.Alerts.Count}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Expander Margin="0 4 0 0" Padding="12 8">
                                    <Expander.Header>
                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                            <asyncImageLoader:AdvancedImage Width="22" Height="22"
                                                                            Source="{Binding Images[icon]}" />
                                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" FontWeight="Medium" />
                                        </StackPanel>
                                    </Expander.Header>
                                    <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" FontSize="13" Margin="32 4 8 8" Opacity="0.8" />
                                </Expander>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Separator Margin="0 16 0 8" />
            <controls1:IconText Glyph="&#xE7C5;" Text="{ci:Tr SettingPages.WeatherSettingsPage.Text.LocationSettings}" Margin="0 0 0 8" />
            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xE7C5;}"
                                        Header="{ci:Tr SettingPages.WeatherSettingsPage.Header.WeatherLocation}"
                                        IsExpanded="True"
                                        Description="{ci:Tr SettingPages.WeatherSettingsPage.Description.SetTheLocationInformationAndAcquisitionMethodFor}">
                <controls3:FASettingsExpander.Footer>
                    <ListBox Theme="{StaticResource ChipListBoxTheme}"
                             SelectionMode="Single"
                             SelectedIndex="{Binding ViewModel.SelectedLocationSource, Mode=TwoWay}">
                        <ListBoxItem Content="{ci:Tr SettingPages.WeatherSettingsPage.Content.SelectCity}" />
                        <ListBoxItem Content="{ci:Tr SettingPages.WeatherSettingsPage.Content.CoordinatePositioning}" IsVisible="{x:Static abstraction:PlatformServices.IsLocationSupported}" />
                    </ListBox>
                </controls3:FASettingsExpander.Footer>
                <!-- 城市选择 -->
                <controls3:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xE478;}"
                                                Content="{ci:Tr SettingPages.WeatherSettingsPage.Content.CitySelection}"
                                                Description="{ci:Tr SettingPages.WeatherSettingsPage.Description.SelectTheCurrentCityForWeatherQueries}">
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="ViewModel.SelectedLocationSource"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <system:Int32>0</system:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <controls3:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ViewModel.SettingsService.Settings.CityName}"
                                       VerticalAlignment="Center" />
                            <Button Content="{ci:FluentIcon &#xE7C9;}" ToolTip.Tip="{ci:Tr SettingPages.WeatherSettingsPage.ToolTip.EditCity}"
                                    Margin="6 0 0 0"
                                    Theme="{StaticResource TransparentButton}"
                                    Click="ButtonEditCurrentCity_OnClick"
                                    Foreground="{DynamicResource PrimaryHueMidBrush}" />
                        </StackPanel>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <!-- 位置坐标 -->
                <controls3:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xEB5A;}"
                                                Content="{ci:Tr SettingPages.WeatherSettingsPage.Content.LocationCoordinates}"
                                                Description="{ci:Tr SettingPages.WeatherSettingsPage.Description.EnterTheLatitudeAndLongitudeCoordinatesUsedTo}">
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="ViewModel.SelectedLocationSource"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <system:Int32>1</system:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <controls3:FASettingsExpanderItem.Footer>
                        <StackPanel Orientation="Horizontal">
                            <Grid RowDefinitions="Auto, Auto">
                                <StackPanel Grid.Row="0" Orientation="Horizontal"
                                            Classes.HideLocationPos="{Binding ViewModel.HideLocationPos}">
                                    <StackPanel.Transitions>
                                        <Transitions>
                                            <EffectTransition Property="Effect" Easing="0.00, 1.00, 0.00, 1.00"
                                                              Duration="0:0:0.15" />
                                            <DoubleTransition Property="Opacity" Easing="0.00, 1.00, 0.00, 1.00"
                                                              Duration="0:0:0.15" />
                                        </Transitions>
                                    </StackPanel.Transitions>
                                    <StackPanel.Styles>
                                        <Style Selector="StackPanel.HideLocationPos">
                                            <Setter Property="Effect" Value="blur(16)" />
                                            <Setter Property="Opacity" Value="0.75" />
                                            <Setter Property="IsHitTestVisible" Value="False" />
                                            <Setter Property="IsTabStop" Value="False" />
                                        </Style>
                                    </StackPanel.Styles>
                                    <ci:Field Prefix="{ci:Tr SettingPages.WeatherSettingsPage.Prefix.Longitude}" Suffix="°" Margin="0 0 2 0"
                                              VerticalAlignment="Center">
                                        <TextBox IsEnabled="{Binding !ViewModel.IsLocationUpdating}"
                                                 Text="{Binding ViewModel.SettingsService.Settings.WeatherLongitude, Converter={StaticResource IntToStringConverter}}"
                                                 MinWidth="75" />
                                    </ci:Field>
                                    <ci:Field Prefix="{ci:Tr SettingPages.WeatherSettingsPage.Prefix.Latitude}" Suffix="°" Margin="2 0 6 0"
                                              VerticalAlignment="Center">
                                        <TextBox IsEnabled="{Binding !ViewModel.IsLocationUpdating}"
                                                 Text="{Binding ViewModel.SettingsService.Settings.WeatherLatitude, Converter={StaticResource IntToStringConverter}}"
                                                 MinWidth="75" />
                                    </ci:Field>
                                </StackPanel>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding ViewModel.SettingsService.Settings.CityName}"
                                           Classes="l-instructive"
                                           FontSize="11"
                                           Margin="4 2 0 0"
                                           IsVisible="{Binding ViewModel.IsLocationPosVisible}" />
                                <Button Grid.Row="0"
                                        Theme="{StaticResource TransparentButton}"
                                        VerticalAlignment="Center" HorizontalAlignment="Center"
                                        Click="ButtonShowPos_OnClick"
                                        IsEnabled="{Binding !ViewModel.IsLocationUpdating}"
                                        IsVisible="{Binding ViewModel.HideLocationPos}">
                                    <controls1:IconText Glyph="&#xE813;" Text="{ci:Tr SettingPages.WeatherSettingsPage.Text.ShowCoordinates}" />
                                </Button>
                            </Grid>
                            <Button Theme="{StaticResource TransparentButton}"
                                    Content="{ci:FluentIcon &#xEBD2;}"
                                    ToolTip.Tip="{ci:Tr SettingPages.WeatherSettingsPage.ToolTip.AutoLocate}"
                                    IsEnabled="{Binding !ViewModel.IsLocationUpdating}"
                                    Click="ButtonGetCurrentPos_OnClick" />
                        </StackPanel>
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
                <!-- 自动获取位置 -->
                <controls3:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xEAEA;}"
                                               Content="{ci:Tr SettingPages.WeatherSettingsPage.Content.AutomaticallyObtainLocation}"
                                               Description="{ci:Tr SettingPages.WeatherSettingsPage.Description.IfEnabledTheLocationInformationWillBeAutomatically}">
                    <controls3:FASettingsExpanderItem.IsVisible>
                        <Binding Path="ViewModel.SelectedLocationSource"
                                 Converter="{x:Static ObjectConverters.Equal}">
                            <Binding.ConverterParameter>
                                <system:Int32>1</system:Int32>
                            </Binding.ConverterParameter>
                        </Binding>
                    </controls3:FASettingsExpanderItem.IsVisible>
                    <controls3:FASettingsExpanderItem.Footer>
                        <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.AutoRefreshWeatherLocation, Mode=TwoWay}" />
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
            </controls3:FASettingsExpander>
            <Separator Margin="0 16 0 8" />
            <controls1:IconText Glyph="&#xE713;" Text="{ci:Tr SettingPages.WeatherSettingsPage.Text.AppearanceAndAdvancedSettings}" Margin="0 0 0 8" />
            <!-- 天气图标包 -->
            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xE9B0;}"
                                        Header="{ci:Tr SettingPages.WeatherSettingsPage.Header.WeatherIconPack}"
                                        Description="{ci:Tr SettingPages.WeatherSettingsPage.Description.AdjustTheAppearanceOfIconsUsedWhenDisplaying}">

                <controls3:FASettingsExpander.Footer>
                    <ComboBox ItemsSource="{x:Static services:IWeatherService.RegisteredTemplates}"
                              HorizontalContentAlignment="Left"
                              MinWidth="120"
                              SelectedValueBinding="{Binding Id}"
                              SelectedValue="{Binding ViewModel.SettingsService.Settings.WeatherIconId}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </controls3:FASettingsExpander.Footer>
            </controls3:FASettingsExpander>

            <!-- 排除预警 -->
            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xE837;}"
                                        Header="{ci:Tr SettingPages.WeatherSettingsPage.Header.ExcludedWeatherAlerts}"
                                        Description="{ci:Tr SettingPages.WeatherSettingsPage.Description.AlertsContainingTheFollowingStringsWillNotBe}">
                <controls3:FASettingsExpanderItem Content="{ci:Tr SettingPages.WeatherSettingsPage.Content.ExclusionList}">
                    <controls3:FASettingsExpanderItem.Footer>
                        <TextBox Padding="8"
                                 MaxHeight="200"
                                 Width="260"
                                 AcceptsReturn="True"
                                 Text="{Binding ViewModel.SettingsService.Settings.ExcludedWeatherAlerts, Converter={StaticResource CollectionToStringConverter}}" />
                    </controls3:FASettingsExpanderItem.Footer>
                </controls3:FASettingsExpanderItem>
            </controls3:FASettingsExpander>

            <!-- TLS 设置 -->
            <controls3:FASettingsExpander IconSource="{ci:FluentIconSource &#xEAB0;}"
                                       Header="{ci:Tr SettingPages.WeatherSettingsPage.Header.DoNotUseTlsProtocolToObtainWeather}"
                                       Description="{ci:Tr SettingPages.WeatherSettingsPage.Description.NotRecommendedToEnableIfEnabledTheApp}">
                <controls3:FASettingsExpander.Footer>
                    <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.NoTLSWeatherRequests, Mode=TwoWay}" />
                </controls3:FASettingsExpander.Footer>
            </controls3:FASettingsExpander>
            <Border Background="{DynamicResource ControlFillColorDefaultBrush}"
                    CornerRadius="8"
                    Padding="12"
                    Margin="0 8 0 0">
                <TextBlock TextWrapping="Wrap" FontSize="12" Opacity="0.8">
                    <Run Text="{ci:Tr SettingPages.WeatherSettingsPage.Content.ToAdjustWeatherAlertSettingsGoTo}"/><ci:NavHyperlink NavTarget="classisland://app/settings/notification" Content="{ci:Tr SettingPages.WeatherSettingsPage.Content.ReminderPage}"/><Run Text="{ci:Tr SettingPages.WeatherSettingsPage.Content.ToAdjustTheWeatherQuickInfoOnThe}"/><ci:NavHyperlink NavTarget="classisland://app/settings/components" Content="{ci:Tr SettingPages.WeatherSettingsPage.Content.WidgetPage}"/><Run Text="{ci:Tr SettingPages.WeatherSettingsPage.Content.ConfigureTheWeatherBriefingWidgetIn}"/>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</controls:SettingsPageBase>
