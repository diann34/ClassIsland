<ci:ViewBase x:Class="ClassIsland.Views.CrashWindow"
                   xmlns="https://github.com/avaloniaui"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                   xmlns:views="clr-namespace:ClassIsland.Views"
                   xmlns:controls="clr-namespace:ClassIsland.Controls"
                   xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
                   xmlns:controls2="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                   xmlns:ci="http://classisland.tech/schemas/xaml/core"
                   d:DataContext="{d:DesignInstance views:CrashWindow}"
                   mc:Ignorable="d"
                   HostStartupLocation="CenterScreen"
                   Icon="/Assets/AppLogo.ico"
                   Header="{ci:Tr CrashWindow.Header.ClassIslandCrashReport}" HostHeight="450" HostWidth="800">
    <Grid Margin="12" RowDefinitions="Auto,Auto,*,Auto,Auto,Auto" ColumnDefinitions="Auto,*">
        <!-- Header -->
        <controls1:StickerControl Grid.Row="0" Grid.Column="0"
                                  Width="48" Height="48"
                                  Margin="0 -8 0 0"
                                  VerticalAlignment="Top"
                                  StickerSource="/Assets/HoYoStickers/光辉矢愿_不可以看.png"
                                  StickerToolTip="光辉矢愿_不可以看"
                                  FallbackIcon="{controls1:FluentIconSource &#xE809;, FontSize=48}"/>
        <TextBlock Grid.Row="0" Grid.Column="1"
                   HorizontalAlignment="Left"
                   VerticalAlignment="Center"
                   Theme="{StaticResource TitleTextBlockStyle}"
                   Margin="8 0 16 16">
            <TextBlock.Styles>
                <Style Selector="TextBlock">
                    <Setter Property="Text" Value="{ci:Tr CrashWindow.Text.ClassIslandEncounteredAnErrorWithEmoticon}"/>
                </Style>
                <Style Selector=":no-easter-eggs TextBlock">
                    <Setter Property="Text" Value="{ci:Tr CrashWindow.Text.ClassIslandEncounteredAnError}"/>
                </Style>
            </TextBlock.Styles>
        </TextBlock>

        <!-- Content -->
        <TextBlock Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" TextWrapping="Wrap" FontSize="14"
                   Margin="0 0 0 6">
            <Run Text="{ci:Tr CrashWindow.Text.ClassIslandHasEncounteredASeriousErrorAndCannot}"/>
        </TextBlock>
        <TextBox Grid.Column="0" Grid.ColumnSpan="2"
                 x:Name="TextBoxCrashInfo" Grid.Row="2"
                 FontSize="13"
                 BorderThickness="0"
                 Padding="0"
                 Margin="0 6 0 0" AcceptsReturn="True"
                 VerticalContentAlignment="Top"
                 IsReadOnly="True" Text="{Binding CrashInfo, Mode=OneWay}"
                 TextAlignment="Left" TextWrapping="Wrap"
                 d:Text="123"/>

        <controls2:FAInfoBar Grid.Row="3"
                           Grid.Column="0" Grid.ColumnSpan="2"
                           IsOpen="{Binding IsCritical}"
                           Severity="Error" IsClosable="False"
                           Margin="0 6 0 0"
                           Message="{ci:Tr CrashWindow.Message.ThisExceptionCannotBeIgnoredYouNeedTo}"/>

        <Separator Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="4" Margin="-12 8 -12 0"/>

        <!-- Bottom -->
        <Grid Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="2"
              ColumnDefinitions="Auto, *, Auto" Margin="-12 0 -12 -12"
              Background="{DynamicResource LayerOnMicaBaseAltFillColorDefaultBrush}">
            <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal" Margin="12">
                <Button Margin="0 0 6 0"
                                IsVisible="{Binding IsCritical, Mode=OneTime}"
                                Click="ButtonDebug_OnClick">
                    <controls1:IconText Glyph="&#xE2C8;" Text="{ci:Tr CrashWindow.Text.Debug}" Spacing="3"/>
                </Button>
                <Button Margin="0 0 6 0"
                        IsVisible="{Binding AllowIgnore, Mode=OneTime}"
                        Click="ButtonIgnore_OnClick">
                    <controls1:IconText Glyph="&#xE671;" Text="{ci:Tr CrashWindow.Text.Ignore}" Spacing="3"/>
                </Button>
                <Button Margin="0 0 6 0" Click="ButtonExit_OnClick">
                    <controls1:IconText Glyph="&#xE0DF;" Text="{ci:Tr CrashWindow.Text.ExitApplication}" Spacing="3"/>
                </Button>
                <Button Click="ButtonRestart_OnClick" Classes="accent">
                    <controls1:IconText Glyph="&#xE0BD;" Text="{ci:Tr CrashWindow.Text.RestartApplication}" Spacing="3"/>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Margin="12">
                <Button Click="ButtonCopy_OnClick" Margin="0 0 6 0">
                    <controls1:IconText Glyph="&#xE58B;" Text="{ci:Tr CrashWindow.Text.Copy}" Spacing="3"/>
                </Button>
                <Button Click="ButtonFeedback_OnClick">
                    <controls1:IconText Glyph="&#xED11;" Text="{ci:Tr CrashWindow.Text.ReportIssue}" Spacing="3"/>
                </Button>
            </StackPanel>
        </Grid>
    </Grid>
</ci:ViewBase>
