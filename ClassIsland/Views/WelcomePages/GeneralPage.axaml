<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:views="clr-namespace:ClassIsland.Views"
             xmlns:welcomePages="clr-namespace:ClassIsland.Views.WelcomePages"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Views.WelcomePages.GeneralPage">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Classes="settings-container animated-intro"
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=welcomePages:GeneralPage}}"
                MaxWidth="600">
        <TextBlock Text="{ci:Tr WelcomePages.GeneralPage.Text.Basic}" HorizontalAlignment="Center"
                   Margin="0 0 0 4"
                   Theme="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBlock Text="{ci:Tr WelcomePages.GeneralPage.Text.ConfigureTheBasicSettingsOfClassIsland}" HorizontalAlignment="Center"
                   Margin="0 0 0 8"/>

        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE304;}"
                                        Header="{ci:Tr WelcomePages.GeneralPage.Header.SemesterStartTime}"
                                        Description="{ci:Tr WelcomePages.GeneralPage.Description.SetTheFirstDayOfTheSemesterWhich}">
            <controls:FASettingsExpander.Footer>
                <StackPanel Orientation="Horizontal"
                            Spacing="4">
                    <CalendarDatePicker SelectedDate="{Binding ViewModel.SettingsService.Settings.SingleWeekStartTime}"
                                MinWidth="120"/>
                </StackPanel>
            </controls:FASettingsExpander.Footer>
        </controls:FASettingsExpander>
        <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE4E8;}"
                                   Header="{ci:Tr WelcomePages.GeneralPage.Header.AnonymousUsageAnalysis}"
                                   Description="{ci:Tr WelcomePages.GeneralPage.Description.ThisAppWillUseTheSentrysdkToCollect}">
            <controls:FASettingsExpander.Footer>
                <ToggleSwitch IsChecked="{Binding ViewModel.SettingsService.Settings.IsSentryEnabled}"/>
            </controls:FASettingsExpander.Footer>
        </controls:FASettingsExpander>

        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
            <Button Click="ButtonNext_OnClick"
                    ToolTip.Tip="{ci:Tr WelcomePages.GeneralPage.ToolTip.NextStep}"
                    Content="{ci:FluentIcon &#xE130;, FontSize=18}"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Classes="accent"
                    Margin="0 8 0 0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
