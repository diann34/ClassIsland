<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:welcomePages="clr-namespace:ClassIsland.Views.WelcomePages"
             xmlns:views="clr-namespace:ClassIsland.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Views.WelcomePages.SystemPage">
    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Padding" Value="8 0"/>
        </Style>
    </UserControl.Styles>
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Classes="settings-container animated-intro"
                DataContext="{Binding RelativeSource={RelativeSource AncestorType=welcomePages:SystemPage}}"
                MaxWidth="600">
        <TextBlock Text="{ci:Tr WelcomePages.SystemPage.Text.System}" HorizontalAlignment="Center"
                   Margin="0 0 0 4"
                   Theme="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBlock Text="{ci:Tr WelcomePages.SystemPage.Text.SetClassIslandSSystemIntegrationFeaturesWhichCan}" HorizontalAlignment="Center"
                   Margin="0 0 0 8"/>

        <CheckBox IsChecked="{Binding ViewModel.CreateStartupShortcut}">
            <CheckBox.IsVisible>
                <OnPlatform Default="True">
                    <On Options="macOS" Content="False"/>
                </OnPlatform>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xE342;}" Header="{ci:Tr WelcomePages.SystemPage.Header.StartOnBoot}"
                      Description="{ci:Tr WelcomePages.SystemPage.Description.RunThisApplicationAutomaticallyAtSystemStartup}" />
        </CheckBox>
        <!--<CheckBox>
            <controls:SettingsControl HasSwitcher="False"
                                      IconGlyph="Link" Header="{ci:Tr WelcomePages.SystemPage.Header.FileAssociation}"
                                      Description="{ci:Tr WelcomePages.SystemPage.Description.RegisterTheCipFileFormatAssociationForEasier}" />
        </CheckBox>-->
        <CheckBox IsChecked="{Binding ViewModel.CreateDesktopShortcut}">
            <CheckBox.IsVisible>
                <OnPlatform Default="True">
                    <On Options="macOS" Content="False"/>
                </OnPlatform>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xE62F;}" Header="{ci:Tr WelcomePages.SystemPage.Header.CreateDesktopShortcuts}"
                      Description="{ci:Tr WelcomePages.SystemPage.Description.AddSoftwareShortcutsToTheDesktop}" />
        </CheckBox>
        <CheckBox IsChecked="{Binding ViewModel.CreateStartMenuShortcut}">
            <CheckBox.IsVisible>
                <MultiBinding Converter="{x:Static BoolConverters.And}">
                    <Binding Converter="{x:Static ObjectConverters.NotEqual}" Source="{x:Static ci:AppBase.Current}"
                             Path="PackagingType" ConverterParameter="deb"/>
                    <Binding Converter="{x:Static ObjectConverters.NotEqual}" Source="{x:Static ci:AppBase.Current}"
                             Path="OperatingSystem" ConverterParameter="macos"/>
                </MultiBinding>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xE064;}"
                      Header="{ci:Tr WelcomePages.SystemPage.Header.CreateAShortcutForTheStartMenu}"
                      Description="{ci:Tr WelcomePages.SystemPage.Description.AddSoftwareShortcutsToTheStartMenu}" />
        </CheckBox>
        <CheckBox IsChecked="{Binding ViewModel.RegisterUrlScheme}">
            <CheckBox.IsVisible>
                <OnPlatform Default="False">
                    <On Options="Windows" Content="True"/>
                </OnPlatform>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xEAB0;}"
                      Header="{ci:Tr WelcomePages.SystemPage.Header.RegisterUrlProtocol}"
                      Description="{ci:Tr WelcomePages.SystemPage.Description.AllowsThirdPartyApplicationsOrWebPagesTo}" />
        </CheckBox>
        <CheckBox Margin="22 0 0 0"
                  IsChecked="{Binding ViewModel.CreateClassSwapShortcut}"
                  IsEnabled="{Binding ViewModel.RegisterUrlScheme}">
            <CheckBox.IsVisible>
                <OnPlatform Default="False">
                    <On Options="Windows" Content="True"/>
                </OnPlatform>
            </CheckBox.IsVisible>
            <ci:Thing IconSource="{ci:FluentIconSource &#xE15F;}"
                      Header="{ci:Tr WelcomePages.SystemPage.Header.CreateACourseSwitchingShortcutOnTheDesktop}"
                      Description="{ci:Tr WelcomePages.SystemPage.Description.OpenThisShortcutToStartCourseSwitchingWith}" />
        </CheckBox>

        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
            <Button Command="{x:Static views:WelcomeWindow.WelcomeNavigateBackCommand}"
                    ToolTip.Tip="{ci:Tr WelcomePages.SystemPage.ToolTip.PreviousStep}"
                    Content="{ci:FluentIcon &#xE108;, FontSize=18}"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Margin="0 8 0 0"/>
            <Button Command="{x:Static views:WelcomeWindow.WelcomeNavigateForwardCommand}"
                    ToolTip.Tip="{ci:Tr WelcomePages.SystemPage.ToolTip.NextStep}"
                    Content="{ci:FluentIcon &#xE130;, FontSize=18}"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Classes="accent"
                    Margin="0 8 0 0"/>
        </StackPanel>
    </StackPanel>
</UserControl>
