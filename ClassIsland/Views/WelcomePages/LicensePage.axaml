<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:views="clr-namespace:ClassIsland.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Views.WelcomePages.LicensePage">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                Classes="settings-container animated-intro">
        <TextBlock Text="{ci:Tr WelcomePages.LicensePage.Text.AgreeToTheLicenseTerms}" HorizontalAlignment="Center"
                   Margin="0 0 0 4"
                   Theme="{StaticResource SubtitleTextBlockStyle}"/>
        <TextBlock Text="{ci:Tr WelcomePages.LicensePage.Text.ToContinueUsingClassIslandYouMustReadAnd}" HorizontalAlignment="Center"/>
        <CheckBox x:Name="ComboBoxOssLicense">
            <TextBlock VerticalAlignment="Center" Margin="0 4 0 0" >
                {ci:Tr WelcomePages.LicensePage.Content.IHaveReadAndAgree}<HyperlinkButton Content="{ci:Tr WelcomePages.LicensePage.Content.ClassIslandOpenSourceLicense}" Margin="0 -2 0 0"
                                        Click="ButtonShowOssLicense_OnClick"/>。
            </TextBlock>
        </CheckBox>
        <CheckBox x:Name="ComboBoxPrivacy">
            <TextBlock VerticalAlignment="Center" Margin="0 4 0 0" >
                {ci:Tr WelcomePages.LicensePage.Content.IHaveReadAndAgree}<HyperlinkButton Content="{ci:Tr WelcomePages.LicensePage.Content.ClassIslandPrivacyPolicy}" Margin="0 -2 0 0"
                                        Click="ButtonShowPrivacyLicense_OnClick"/>。
            </TextBlock>
        </CheckBox>
        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
            <Button Command="{x:Static views:WelcomeWindow.WelcomeNavigateForwardCommand}"
                    ToolTip.Tip="{ci:Tr WelcomePages.LicensePage.ToolTip.NextStep}"
                    Content="{ci:FluentIcon &#xE130;, FontSize=18}"
                    Width="48" Height="48"
                    CornerRadius="24"
                    Classes="accent"
                    Margin="0 8 0 0">
                <Button.IsEnabled>
                    <MultiBinding Converter="{x:Static BoolConverters.And}" >
                        <Binding Path="#ComboBoxOssLicense.IsChecked"/>
                        <Binding Path="#ComboBoxPrivacy.IsChecked"/>
                    </MultiBinding>
                </Button.IsEnabled>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
