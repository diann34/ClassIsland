<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:views="clr-namespace:ClassIsland.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="ClassIsland.Views.DataTransferPage">
    <UserControl.Styles>
        <Style Selector="CheckBox">
            <Setter Property="Padding" Value="8 0"/>
        </Style>
    </UserControl.Styles>
    <ScrollViewer DataContext="{Binding RelativeSource={RelativeSource AncestorType=views:DataTransferPage}}"
                  Classes.export="{Binding ViewModel.IsExport}">
        <Grid MaxWidth="600"
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Center">

            <Carousel Width="600" SelectedIndex="{Binding ViewModel.PageIndex}"
                      VerticalAlignment="Stretch"
                      ClipToBounds="False">
                <Carousel.Items>
                    <Border VerticalAlignment="Center">
                        <StackPanel>
                            <TextBlock Text="{ci:Tr DataTransferPage.Text.DataMigration}" HorizontalAlignment="Center"
                                       Margin="0 0 0 4"
                                       Theme="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock Text="{ci:Tr DataTransferPage.Text.ImportDataToOrExportDataFromClassIsland}"
                                       HorizontalAlignment="Center"
                                       Margin="0 0 0 8" />
                            <TabControl Classes="compact">
                                <TabItem Header="{ci:Tr DataTransferPage.Header.Import}">
                                    <StackPanel Classes="animated-intro" Spacing="2">
                                        <controls:FASettingsExpander Header="ClassIsland 2.x"
                                                                   IsClickEnabled="True"
                                                                   Click="SettingsExpanderImportFromClassIsland2_OnClick">
                                            <controls:FASettingsExpander.IconSource>
                                                <controls:FABitmapIconSource
                                                    UriSource="avares://ClassIsland/Assets/AppLogo.png" />
                                            </controls:FASettingsExpander.IconSource>
                                        </controls:FASettingsExpander>
                                        <controls:FASettingsExpander Header="ClassIsland 1.7.0.x"
                                                                   IsClickEnabled="True"
                                                                   Click="SettingsExpanderImportFromClassIsland1_OnClick">
                                            <controls:FASettingsExpander.IconSource>
                                                <controls:FABitmapIconSource
                                                    UriSource="avares://ClassIsland/Assets/AppLogo.png" />
                                            </controls:FASettingsExpander.IconSource>
                                        </controls:FASettingsExpander>
                                        <controls:FASettingsExpander Header="Class Widgets 1.2"
                                                                   IsClickEnabled="True"
                                                                   Click="ImportFromClassWidgets1_OnClick"
                                                                   IconSource="{ci:FluentIconSource &#xe06f;}" />
                                    </StackPanel>
                                </TabItem>
                                <TabItem Header="{ci:Tr DataTransferPage.Header.Export}">
                                    <StackPanel Classes="animated-intro" Spacing="2">
                                        <controls:FAInfoBar Message="{ci:Tr DataTransferPage.Message.TheDataExportFunctionHereIsMainlyUsed}"
                                                          IsOpen="True" IsClosable="False"/>
                                        <controls:FASettingsExpander Header="ClassIsland 2.x"
                                                                   IsClickEnabled="True"
                                                                   Click="SettingsExpanderExportToClassIsland2_OnClick">
                                            <controls:FASettingsExpander.IconSource>
                                                <controls:FABitmapIconSource
                                                    UriSource="avares://ClassIsland/Assets/AppLogo.png" />
                                            </controls:FASettingsExpander.IconSource>
                                        </controls:FASettingsExpander>
                                    </StackPanel>
                                </TabItem>
                            </TabControl>
                        </StackPanel>
                    </Border>
                    <Border VerticalAlignment="Center">
                        <StackPanel Classes="animated-intro" Spacing="2" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="0 0 0 4"
                                       Theme="{StaticResource SubtitleTextBlockStyle}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.SelectDataToImport}"/>
                                    </Style>
                                    <Style Selector=".export TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.SelectDataToExport}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <TextBlock Text="{Binding ViewModel.ImportDescription}"
                                       HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0 0 0 4"/>
                            <TextBlock HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0 0 0 8">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.SelectInformationToImport}"/>
                                    </Style>
                                    <Style Selector=".export TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.SelectInformationToExport}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <CheckBox IsChecked="{Binding ViewModel.IsProfileSelected}">
                                <ci:Thing IconSource="{ci:FluentIconSource &#xe699;}"
                                          VerticalAlignment="Center"
                                          Header="{ci:Tr DataTransferPage.Header.TimetableConfiguration}"
                                          Description="{ci:Tr DataTransferPage.Description.IncludesTimetableContentScheduleSubjectDefinitionsAndOth}"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ViewModel.IsSettingsSelected}">
                                <ci:Thing IconSource="{ci:FluentIconSource &#xef27;}"
                                          Header="{ci:Tr DataTransferPage.Header.ApplicationSettings}"
                                          VerticalAlignment="Center"
                                          Description="{ci:Tr DataTransferPage.Description.IncludesVariousApplicationPreferencesSuchAsHiddenSetting}"/>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ViewModel.IsOtherConfigSelected}">
                                <ci:Thing IconSource="{ci:FluentIconSource &#xe06f;}"
                                          Header="{ci:Tr DataTransferPage.Header.OtherConfiguration}"
                                          VerticalAlignment="Center"
                                          Description="{ci:Tr DataTransferPage.Description.ComponentsAutomationAndOtherConfigurationFiles}"/>
                            </CheckBox>
                            <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                                <Button Click="ButtonTurnBack_OnClick"
                                        ToolTip.Tip="{ci:Tr DataTransferPage.ToolTip.PreviousStep}"
                                        Content="{ci:FluentIcon &#xE108;, FontSize=18}"
                                        Width="48" Height="48"
                                        CornerRadius="24"
                                        Margin="0 8 0 0"/>
                                <Button Click="ButtonNext_OnClick"
                                        ToolTip.Tip="{ci:Tr DataTransferPage.ToolTip.NextStep}"
                                        Content="{ci:FluentIcon &#xE130;, FontSize=18}"
                                        Width="48" Height="48"
                                        CornerRadius="24"
                                        Classes="accent"
                                        Margin="0 8 0 0"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <Border VerticalAlignment="Center">
                        <StackPanel Classes="animated-intro" Spacing="2" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="0 0 0 4"
                                       Theme="{StaticResource SubtitleTextBlockStyle}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.ImportSource}"/>
                                    </Style>
                                    <Style Selector=".export TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.ExportDestination}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       Margin="0 0 0 8">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.SelectTheDataSourceToImport}"/>
                                    </Style>
                                    <Style Selector=".export TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.SelectTheDestinationToExportTo}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>

                            <controls:FASettingsExpander Header="{ci:Tr DataTransferPage.Header.Browse}"
                                                       IconSource="{ci:FluentIconSource &#xe88d;}"
                                                       IsClickEnabled="True"
                                                       Click="SettingsExpanderBrowse_OnClick">
                                <controls:FASettingsExpander.Styles>
                                    <Style Selector="controls|FASettingsExpander">
                                        <Setter Property="Description" Value="{ci:Tr DataTransferPage.Description.BrowseForImportLocationManually}"/>
                                    </Style>
                                    <Style Selector=".export controls|FASettingsExpander">
                                        <Setter Property="Description" Value="{ci:Tr DataTransferPage.Description.BrowseForExportLocationManually}"/>
                                    </Style>
                                </controls:FASettingsExpander.Styles>
                            </controls:FASettingsExpander>
                            <Button Click="ButtonTurnBack_OnClick"
                                    ToolTip.Tip="{ci:Tr DataTransferPage.ToolTip.PreviousStep}"
                                    Content="{ci:FluentIcon &#xE108;, FontSize=18}"
                                    Width="48" Height="48"
                                    CornerRadius="24"
                                    HorizontalAlignment="Center"
                                    Margin="0 8 0 0"/>
                        </StackPanel>
                    </Border>
                    <Border VerticalAlignment="Center">
                        <StackPanel Classes="animated-intro" Spacing="2" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="0 0 0 4"
                                       Theme="{StaticResource SubtitleTextBlockStyle}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.Importing}"/>
                                    </Style>
                                    <Style Selector=".export TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.Exporting}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <TextBlock
                                HorizontalAlignment="Center"
                                TextAlignment="Center"
                                TextWrapping="Wrap"
                                Margin="0 0 0 4">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.ImportWillFinishSoon}"/>
                                    </Style>
                                    <Style Selector=".export TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.ExportWillFinishSoon}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <controls:FAProgressRing IsIndeterminate="True"
                                                   Width="48" Height="48"
                                                   Margin="0 8 0 0"/>
                        </StackPanel>
                    </Border>
                    <Border VerticalAlignment="Center">
                        <StackPanel Classes="animated-intro" Spacing="2" VerticalAlignment="Center">
                            <TextBlock HorizontalAlignment="Center"
                                       Margin="0 0 0 4"
                                       Theme="{StaticResource SubtitleTextBlockStyle}">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.ImportCompleted}"/>
                                    </Style>
                                    <Style Selector=".export TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.ExportCompleted}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <TextBlock HorizontalAlignment="Center"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap"
                                       Margin="0 0 0 4">
                                <TextBlock.Styles>
                                    <Style Selector="TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.ImportCompletedSuccessfully}"/>
                                    </Style>
                                    <Style Selector=".export TextBlock">
                                        <Setter Property="Text" Value="{ci:Tr DataTransferPage.Text.ExportCompletedSuccessfully}"/>
                                    </Style>
                                </TextBlock.Styles>
                            </TextBlock>
                            <Button ToolTip.Tip="{ci:Tr DataTransferPage.ToolTip.Done}"
                                    VerticalAlignment="Center"
                                    Content="{ci:FluentIcon &#xE423;, FontSize=18}"
                                    Width="48" Height="48"
                                    CornerRadius="24"
                                    Classes="accent"
                                    HorizontalAlignment="Center"
                                    Click="ButtonFinish_OnClick"
                                    Margin="0 8 0 0"/>
                        </StackPanel>
                    </Border>
                </Carousel.Items>
                <Carousel.PageTransition>
                    <CompositePageTransition>
                        <PageSlide Duration="0:0:0.3" Orientation="Horizontal"
                                   SlideOutEasing="0.76, 0, 0.24, 1"
                                   SlideInEasing="0.76, 0, 0.24, 1"/>
                        <CrossFade Duration="0:0:0.3"/>
                    </CompositePageTransition>
                </Carousel.PageTransition>
            </Carousel>
        </Grid>
    </ScrollViewer>
</UserControl>
