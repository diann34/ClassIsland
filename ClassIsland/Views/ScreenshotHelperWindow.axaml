<ci:ViewBase xmlns="https://github.com/avaloniaui"
          xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
          xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
          xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
          xmlns:ci="http://classisland.tech/schemas/xaml/core"
          xmlns:views="clr-namespace:ClassIsland.Views"
          mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
          x:Class="ClassIsland.Views.ScreenshotHelperWindow"
          Header="{ci:Tr ScreenshotHelperWindow.Header.Screenshot}"
          d:DataContext="{d:DesignInstance views:ScreenshotHelperWindow}">
    <StackPanel Spacing="4">
        <ci:Field Label="{ci:Tr ScreenshotHelperWindow.Label.Window}">
            <ComboBox ItemsSource="{Binding ViewModel.Windows}"
                      SelectedItem="{Binding ViewModel.SelectedWindow}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock>
                            <Run Text="{Binding Window.Title}"/>
                            (Id=<Run Text="{Binding Id}"/>)
                            [<Run Text="{Binding Type}"/>]
                        </TextBlock>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </ci:Field>
        <ci:Field Label="{ci:Tr ScreenshotHelperWindow.Label.SaveFolder}">
            <TextBox Text="{Binding ViewModel.ImageBasePath}"/>
        </ci:Field>
        <ci:Field Label="{ci:Tr ScreenshotHelperWindow.Label.Scale}">
            <NumericUpDown Value="{Binding ViewModel.Scale, Converter={x:Static ci:NotNaNConverter.Instance}}"/>
        </ci:Field>
        <Grid>
            <Button HorizontalAlignment="Left" Click="ButtonRefresh_OnClick">{ci:Tr ScreenshotHelperWindow.Content.Refresh}</Button>
            <Button HorizontalAlignment="Right" Classes="accent" Click="ButtonScreenshot_OnClick">{ci:Tr ScreenshotHelperWindow.Content.Screenshot}</Button>
        </Grid>
    </StackPanel>
</ci:ViewBase>
