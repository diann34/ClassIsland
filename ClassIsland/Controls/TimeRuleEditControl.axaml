<UserControl x:Class="ClassIsland.Controls.TimeRuleEditControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:controls="clr-namespace:ClassIsland.Controls"
             xmlns:viewModels="clr-namespace:ClassIsland.ViewModels">
    <UserControl.Styles>
        <Style Selector=":is(Control).faded">
            <Setter Property="Opacity" Value="0.60"/>
        </Style>
    </UserControl.Styles>
    <UserControl.Resources>
        <ci:PreventNullConverter x:Key="PreventNullConverter" />
    </UserControl.Resources>
    <StackPanel>
        <Separator Margin="0 8 0 8" />
        <ci:IconText Text="{ci:Tr Controls.TimeRuleEditControl.Text.TriggerRule}" Glyph="&#xf17e;" Margin="0 0 0 8" />
        <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.TheTimetableOnlyTakesEffectWhenAllRules}" TextWrapping="Wrap"
                   Classes="l-instructive"/>

        <TabStrip Theme="{StaticResource TabStripStyle}"
                  Classes="compact"
                  SelectedIndex="{Binding $parent[controls:TimeRuleEditControl].TimeRule.Type, Converter={x:Static ci:EnumToIntConverter.Instance}}"
                  Margin="0 6 0 0"
                  HorizontalAlignment="Stretch">
            <TabStrip.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="3"/>
                </ItemsPanelTemplate>
            </TabStrip.ItemsPanel>
            <TabStripItem>
                <ci:AnimatedIconButton Glyph="{ci:FI CalendarRegular}" Text="{ci:Tr Controls.TimeRuleEditControl.Text.Weekly}"
                                             Classes="display-role"
                                             IsKeepingExpanded="True"/>
            </TabStripItem>
            <TabStripItem>
                <ci:AnimatedIconButton Glyph="{ci:FI CalendarDayRegular}" Text="{ci:Tr Controls.TimeRuleEditControl.Text.ACertainDay}"
                                             Classes="display-role"
                                             IsKeepingExpanded="True"/>
            </TabStripItem>
            <TabStripItem>
                <ci:AnimatedIconButton Glyph="{ci:FI ArrowRepeatAllRegular}" Text="{ci:Tr Controls.TimeRuleEditControl.Text.Cycle}"
                                       Classes="display-role"
                                       IsKeepingExpanded="True"/>
            </TabStripItem>
        </TabStrip>

        <ci:ReusableTabControl
            Padding="0"
            Margin="0 4 0 0"
            SelectedIndex="{Binding $parent[controls:TimeRuleEditControl].TimeRule.Type, Mode=OneWay, Converter={x:Static ci:EnumToIntConverter.Instance}}">
            <ci:ReusableTabControl.Styles>
                <Style Selector="TabControl /template/ ItemsPresenter#PART_ItemsPresenter">
                    <Setter Property="Height" Value="0"/>
                    <Setter Property="IsHitTestVisible" Value="False"/>
                    <Setter Property="ClipToBounds" Value="True"/>
                </Style>
            </ci:ReusableTabControl.Styles>
            <TabItem Header="">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Classes="items-valign-center"
                                x:Name="StackPanelWeekDivSettings"
                                Spacing="2">
                        <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.Every}"
                                   Classes.faded="{Binding !!!$parent[controls:TimeRuleEditControl].ViewModel.WeekCountDivIndex}"/>
                        <ComboBox x:Name="WeekCountDivTotalListBox"
                                  SelectedIndex="{Binding $parent[controls:TimeRuleEditControl].ViewModel.WeekCountDivTotalIndex}"
                                  Classes.faded="{Binding !!!$parent[controls:TimeRuleEditControl].ViewModel.WeekCountDivIndex}"/>
                        <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.Of}"
                                   Classes.faded="{Binding !!!$parent[controls:TimeRuleEditControl].ViewModel.WeekCountDivIndex}"/>
                        <ComboBox x:Name="WeekCountDivListBox"
                                  SelectedIndex="{Binding $parent[controls:TimeRuleEditControl].ViewModel.WeekCountDivIndex}"/>
                    </StackPanel>

                    <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.WhenTodayIs}" />
                    <ListBox ItemsSource="{x:Static viewModels:TimeRuleEditViewModel.WeekDayOptions}"
                             SelectedIndex="{Binding $parent[controls:TimeRuleEditControl].TimeRule.WeekDay, Converter={StaticResource PreventNullConverter}}"
                             Theme="{StaticResource ChipListBoxTheme}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           HorizontalAlignment="Center"/>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="7"/>
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>
                </StackPanel>
            </TabItem>
            <TabItem Header="">
                <StackPanel Spacing="2" >
                    <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.WhenTodayIsAnyOfTheFollowingDates}"/>
                    <ListBox ItemsSource="{Binding $parent[controls:TimeRuleEditControl].TimeRule.EnableDates}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <DockPanel >
                                    <StackPanel Orientation="Horizontal" Spacing="4" Margin="4 0 0 0"
                                                DockPanel.Dock="Right">

                                        <Button Theme="{StaticResource TransparentButton}"
                                                ToolTip.Tip="{ci:Tr Controls.TimeRuleEditControl.ToolTip.Edit}"
                                                Command="{Binding $parent[controls:TimeRuleEditControl].PreEditSelectedDateCommand}"
                                                CommandParameter="{Binding}">
                                            <Button.Flyout>
                                                <Flyout Placement="Top">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.ModifyDate}" FontWeight="Bold"/>
                                                        <CalendarDatePicker SelectedDate="{Binding $parent[controls:TimeRuleEditControl].ViewModel.NewDateTime}"/>
                                                        <Button Content="{ci:Tr Controls.TimeRuleEditControl.Content.Confirm}" Classes="accent"
                                                                Tag="{Binding}"
                                                                Command="{Binding $parent[controls:TimeRuleEditControl].CommitEditSelectedDateCommand}"
                                                                CommandParameter="{Binding $self}"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                            <ci:FluentIcon Glyph="{ci:FI EditRegular}"/>
                                        </Button>
                                        <Button Theme="{StaticResource TransparentButton}"
                                                Command="{Binding $parent[controls:TimeRuleEditControl].RemoveDateCommand}"
                                                CommandParameter="{Binding}"
                                                ToolTip.Tip="{ci:Tr Controls.TimeRuleEditControl.ToolTip.Remove}">
                                            <ci:FluentIcon Glyph="{ci:FI DismissRegular}"/>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Converter={x:Static controls:TimeRuleEditControl.DateOnlyToDateTimeConverter}, StringFormat='yyyy/MM/dd ddd'}"
                                               VerticalAlignment="Center"/>
                                </DockPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Button Theme="{StaticResource TransparentButton}">
                        <Button.Flyout>
                            <Flyout Placement="Top">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.AddEnabledDate}" FontWeight="Bold"/>
                                    <CalendarDatePicker SelectedDate="{Binding $parent[controls:TimeRuleEditControl].ViewModel.NewDateTime}"/>
                                    <Button Content="{ci:Tr Controls.TimeRuleEditControl.Content.Confirm}" Classes="accent"
                                            Command="{Binding $parent[controls:TimeRuleEditControl].CommitEditSelectedDateCommand}"
                                            CommandParameter="{Binding $self}"/>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                        <ci:IconText Glyph="{ci:FI AddRegular}" Text="{ci:Tr Controls.TimeRuleEditControl.Text.Added}"/>
                    </Button>
                </StackPanel>
            </TabItem>
            <TabItem Header="">
                <StackPanel Spacing="6">
                    <WrapPanel Classes="items-valign-center" ItemSpacing="4">
                        <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.SinceTheStartOfSchoolEvery}"/>
                        <NumericUpDown Value="{Binding $parent[controls:TimeRuleEditControl].TimeRule.LoopCycleDays, Converter={x:Static ci:NotNaNConverter.Instance}}"
                                       MinWidth="100"
                                       Minimum="1"/>
                        <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.EnableOnceADay}"/>
                    </WrapPanel>
                    <WrapPanel Classes="items-valign-center" ItemSpacing="4">
                        <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.OffsetBack}"/>
                        <NumericUpDown Value="{Binding $parent[controls:TimeRuleEditControl].TimeRule.LoopOffsetDays, Converter={x:Static ci:NotNaNConverter.Instance}}"
                                       MinWidth="100"
                                       Minimum="0"
                                       Maximum="{Binding $parent[controls:TimeRuleEditControl].TimeRule.LoopCycleDays, Converter={x:Static controls:TimeRuleEditControl.CycleDaysToMaxOffsetDaysConverter}}"/>
                        <TextBlock Text="{ci:Tr Controls.TimeRuleEditControl.Text.Days}"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>
        </ci:ReusableTabControl>

        <CheckBox Content="{ci:Tr Controls.TimeRuleEditControl.Content.AndTodayFallsWithinTheFollowingDateRange}" IsChecked="{Binding $parent[controls:TimeRuleEditControl].TimeRule.RestrictsEnableRange}"
                  Margin="0 4 0 0"/>
        <Grid IsVisible="{Binding $parent[controls:TimeRuleEditControl].TimeRule.RestrictsEnableRange}"
              ColumnDefinitions="Auto * Auto * Auto"
              Classes="items-valign-center">
            <TextBlock Text="[" Grid.Column="0" Margin="0 0 4 0"/>
            <CalendarDatePicker Grid.Column="1"
                                HorizontalAlignment="Stretch"
                                DisplayDateEnd="{Binding $parent[controls:TimeRuleEditControl].TimeRule.RangeEnd, Converter={x:Static controls:TimeRuleEditControl.DateOnlyToDateTimeConverter}}"
                                SelectedDate="{Binding $parent[controls:TimeRuleEditControl].TimeRule.RangeStart, Converter={x:Static controls:TimeRuleEditControl.DateOnlyToDateTimeConverter}}"/>
            <TextBlock Text="~" Grid.Column="2" Margin="8 0"/>
            <CalendarDatePicker Grid.Column="3"
                                HorizontalAlignment="Stretch"
                                DisplayDateStart="{Binding $parent[controls:TimeRuleEditControl].TimeRule.RangeStart, Converter={x:Static controls:TimeRuleEditControl.DateOnlyToDateTimeConverter}}"
                                SelectedDate="{Binding $parent[controls:TimeRuleEditControl].TimeRule.RangeEnd, Converter={x:Static controls:TimeRuleEditControl.DateOnlyToDateTimeConverter}}"/>
            <TextBlock Text="]" Grid.Column="4" Margin="4 0 0 0"/>
        </Grid>
    </StackPanel>
</UserControl>
