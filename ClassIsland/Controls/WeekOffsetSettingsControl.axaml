<UserControl x:Class="ClassIsland.Controls.WeekOffsetSettingsControl"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             Loaded="Control_OnLoaded">
    <StackPanel Spacing="0" Margin="0">
        <TextBlock Text="{ci:Tr Controls.WeekOffsetSettingsControl.Text.AdjustThePositionOfMultiWeekRotationFor}"
                   FontSize="16"
                   Margin="0 6 0 8"/>

        <ScrollViewer MaxHeight="305" x:Name="ContentScrollViewer" Padding="0 0 14 0 ">
            <StackPanel x:Name="ContentPanel" Margin="0 -4 0 0" MaxWidth="350" HorizontalAlignment="Left"/>
        </ScrollViewer>

        <WrapPanel Margin="0 12 0 0">
            <Button HorizontalAlignment="Left" Click="ButtonFinish_OnClick" Classes="accent">
                <ci:IconText Glyph="&#xE424;" Text="{ci:Tr Controls.WeekOffsetSettingsControl.Text.Apply}" />
            </Button>
            <Button Click="ButtonClear_OnClick" Margin="6 0 0 0 "
                    ToolTip.Tip="{ci:Tr Controls.WeekOffsetSettingsControl.ToolTip.ResetMultiWeekRotationOffsetToTheStart}">
                <ci:IconText Glyph="&#xE0BE;" Text="{ci:Tr Controls.WeekOffsetSettingsControl.Text.Reset}"/>
            </Button>
        </WrapPanel>
    </StackPanel>
</UserControl>