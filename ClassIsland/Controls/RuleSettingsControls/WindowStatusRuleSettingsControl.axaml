<ci:RuleSettingsControlBase
    x:TypeArguments="rules:WindowStatusRuleSettings"
    x:Class="ClassIsland.Controls.RuleSettingsControls.WindowStatusRuleSettingsControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:ClassIsland.Controls.RuleSettingsControls"
    xmlns:ci="http://classisland.tech/schemas/xaml/core"
    xmlns:rules="clr-namespace:ClassIsland.Models.Rules"
    mc:Ignorable="d"
    d:DesignHeight="450" d:DesignWidth="800">
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:WindowStatusRuleSettingsControl}}">
        <ComboBox SelectedIndex="{Binding Settings.State}"
                  >
            <ComboBoxItem Content="{ci:Tr Controls.RuleSettingsControls.WindowStatusRuleSettingsControl.Content.Normal}"/>
            <ComboBoxItem Content="{ci:Tr Controls.RuleSettingsControls.WindowStatusRuleSettingsControl.Content.Maximize}"/>
            <ComboBoxItem Content="{ci:Tr Controls.RuleSettingsControls.WindowStatusRuleSettingsControl.Content.Minimize}"/>
            <ComboBoxItem Content="{ci:Tr Controls.RuleSettingsControls.WindowStatusRuleSettingsControl.Content.FullScreen}"/>
        </ComboBox>
    </Grid>
</ci:RuleSettingsControlBase>
