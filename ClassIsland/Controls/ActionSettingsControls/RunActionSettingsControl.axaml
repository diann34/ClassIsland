<ci:ActionSettingsControlBase x:Class="ClassIsland.Controls.ActionSettingsControls.RunActionSettingsControl"
                              x:TypeArguments="actionSettings:RunActionSettings"
                              d:DataContext="{d:DesignInstance Type=local:RunActionSettingsControl}"
                              xmlns="https://github.com/avaloniaui"
                              xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                              xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                              xmlns:ci="http://classisland.tech/schemas/xaml/core"
                              xmlns:local="clr-namespace:ClassIsland.Controls.ActionSettingsControls"
                              xmlns:actionSettings="clr-namespace:ClassIsland.Models.Actions">
    <Panel>
        <Grid ColumnDefinitions="Auto * Auto"
              RowDefinitions="Auto Auto">
            <ComboBox Margin="0 0 3 0"
                      SelectedIndex="{Binding Settings.RunType}">
                <ci:IconText Glyph="&#xF4B1;"
                             Text="{ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.Text.Application}" />
                <ci:IconText Glyph="&#xE508;">
                    <ci:IconText.Text>
                        <OnPlatform Default="{ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.Default.TerminalCommand}">
                            <On Options="Windows" Content="{ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.Content.CmdCommand}" />
                        </OnPlatform>
                    </ci:IconText.Text>
                </ci:IconText>
                <ci:IconText Glyph="&#xE687;"
                             Text="{ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.Text.File}" />
                <ci:IconText Glyph="&#xE875;"
                             Text="{ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.Text.Folder}" />
                <ci:IconText Glyph="&#xE905;"
                             Text="{ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.Text.UrlLink}" />
            </ComboBox>
            <TextBox Grid.Row="0"
                     Grid.Column="1"
                     Margin="0 0 0 2"
                     Text="{Binding Settings.Value, Mode=TwoWay}"
                     Watermark="{Binding $parent[local:RunActionSettingsControl].Watermark}"
                     ToolTip.Tip="{Binding $parent[local:RunActionSettingsControl].Watermark}"
                     Tag="{Binding ElementName=FileSelectorButton, Path=IsVisible}">
                <TextBox.Styles>
                    <Style Selector="TextBox[Tag=True]">
                        <Setter Property="Padding"
                                Value="{Binding ElementName=FileSelectorButton, Path=Bounds.Width,
                                Converter={x:Static ci:AnimatedIconButton.TextBlockPaddingFuncConverter}}"/>
                    </Style>
                </TextBox.Styles>
            </TextBox>
            <ci:AnimatedIconButton Name="FileSelectorButton"
                                   Grid.Row="0"
                                   Grid.Column="1"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Stretch"
                                   VerticalContentAlignment="Center"
                                   Glyph="&#xE88D;"
                                   Text="{ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.Text.Select}"
                                   IsVisible="{Binding $parent[local:RunActionSettingsControl].IsFileSelector}"
                                   Theme="{StaticResource TransparentButton}"
                                   Click="FileSelectorButton_OnClick"
                                   ToolTip.Tip="{Binding $parent[local:RunActionSettingsControl].Watermark, StringFormat={ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.Format.SelectValue}}" />
            <TextBox Grid.Row="1"
                     Grid.Column="1"
                     Text="{Binding Settings.Args, Mode=TwoWay}"
                     IsVisible="{Binding $parent[local:RunActionSettingsControl].IsApplication}"
                     Watermark="{ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.Watermark.OptionalApplicationStartupParameters}"
                     ToolTip.Tip="{ci:Tr Controls.ActionSettingsControls.RunActionSettingsControl.ToolTip.OptionalApplicationStartupParameters}" />
        </Grid>
    </Panel>
</ci:ActionSettingsControlBase>
