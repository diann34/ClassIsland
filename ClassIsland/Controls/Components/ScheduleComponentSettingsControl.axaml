<ci:ComponentBase x:Class="ClassIsland.Controls.Components.ScheduleComponentSettingsControl"
                  x:TypeArguments="componentSettings:LessonControlSettings"
                  xmlns="https://github.com/avaloniaui"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:local="clr-namespace:ClassIsland.Controls.Components"
                  xmlns:models="clr-namespace:ClassIsland.Models"
                  xmlns:ci="http://classisland.tech/schemas/xaml/core"
                  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                  xmlns:componentSettings="clr-namespace:ClassIsland.Models.ComponentSettings"
                  xmlns:system="clr-namespace:System;assembly=System.Runtime"
                  xmlns:controls="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                  mc:Ignorable="d"
                  d:DesignHeight="450" d:DesignWidth="800">
    <ci:ComponentBase.Resources>
    </ci:ComponentBase.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:ScheduleComponentSettingsControl}}">
        <ScrollViewer>
            <StackPanel Classes="animated-intro component-settings-container">
                <!-- 附加设置覆盖提示 -->
                <controls:FAInfoBar IsOpen="True" Message="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Message.TheSettingsHereCanBeOverwrittenByThe}">
                    <controls:FAInfoBar.ActionButton>
                        <Button DockPanel.Dock="Right"
                                Foreground="{DynamicResource MaterialDesignBody}"
                                Click="ButtonShowAttachedSettings_OnClick" Content="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.View}">
                        </Button>
                    </controls:FAInfoBar.ActionButton>
                </controls:FAInfoBar>

                <!-- 显示时间点附加信息 -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF14B;}"
                                           Header="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Header.ShowAdditionalInformationOfTheTimePoint}"
                                           Description="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Description.DisplaysAdditionalInformationAtTheCurrentPointIn}"
                                           IsExpanded="{Binding Settings.ShowExtraInfoOnTimePoint, Mode=OneWay}">
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.ShowExtraInfoOnTimePoint, Mode=TwoWay}"/>
                    </controls:FASettingsExpander.Footer>
                    <controls:FASettingsExpanderItem Content="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.AdditionalInformationToDisplay}">
                        <controls:FASettingsExpanderItem.Footer>
                            <ComboBox Grid.Row="0" Grid.Column="1"
                                      VerticalAlignment="Center"
                                      Foreground="{DynamicResource MaterialDesignBody}"
                                      SelectedIndex="{Binding Settings.ExtraInfoType}"
                                      HorizontalContentAlignment="Left"
                                      HorizontalAlignment="Right">
                                <ComboBoxItem HorizontalContentAlignment="Left">
                                    <TextBlock Text="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Text.DurationOfTheTimePoint}" />
                                </ComboBoxItem>
                                <ComboBoxItem HorizontalContentAlignment="Left">
                                    <TextBlock Text="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Text.ElapsedTimeDuration}" />
                                </ComboBoxItem>
                                <ComboBoxItem HorizontalContentAlignment="Left">
                                    <TextBlock Text="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Text.RemainingTimeDuration}" />
                                </ComboBoxItem>
                                <ComboBoxItem HorizontalContentAlignment="Left">
                                    <TextBlock Text="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Text.ElapsedTimePercentage}" />
                                </ComboBoxItem>
                                <ComboBoxItem HorizontalContentAlignment="Left">
                                    <TextBlock Text="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Text.RemainingTime}" />
                                </ComboBoxItem>
                                <ComboBoxItem HorizontalContentAlignment="Left">
                                    <TextBlock Text="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Text.Countdown}" />
                                </ComboBoxItem>
                            </ComboBox>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem Content="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.DisplaysPreciseCountdowns}">
                        <controls:FASettingsExpanderItem.Footer>
                            <StackPanel Orientation="Horizontal" Grid.Row="1" Grid.Column="1" Margin="0 5 0 -3" HorizontalAlignment="Right">
                                <!-- <StackPanel.Style> -->
                                <!--     <Style TargetType="StackPanel"> -->
                                <!--         <Style.Triggers> -->
                                <!--             <DataTrigger Binding="{Binding Settings.ExtraInfoType}" Value="4"> -->
                                <!--                 <Setter Property="Visibility" Value="Visible"/> -->
                                <!--             </DataTrigger> -->
                                <!--         </Style.Triggers> -->
                                <!--         <Setter Property="Visibility" Value="Collapsed"/> -->
                                <!--     </Style> -->
                                <!-- </StackPanel.Style> -->

                                <TextBlock Text="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Text.WhenTheRemainingTimeIsInsufficient}" VerticalAlignment="Center"
                                           Opacity="0.75"/>
                                <NumericUpDown Value="{Binding Settings.ExtraInfo4ShowSecondsSeconds}"
                                         MinWidth="75" Margin="6 0 6 0" TextAlignment="Center"/>
                                <TextBlock Text="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Text.Seconds}" VerticalAlignment="Center"
                                           Opacity="0.75"/>
                            </StackPanel>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                </controls:FASettingsExpander>

                <!-- 时间点结束倒计时 -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF361;}"
                                           Header="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Header.CountdownToTheTimePointEnd}"
                                           Description="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Description.DisplaysTheCountdownAsTheCurrentPointIs}"
                                           IsExpanded="{Binding Settings.IsCountdownEnabled, Mode=OneWay}">
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsCountdownEnabled, Mode=TwoWay}"/>
                    </controls:FASettingsExpander.Footer>
                    <controls:FASettingsExpanderItem Content="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.CountdownDurationToTheEndOfATime}">
                        <controls:FASettingsExpanderItem.Footer>
                            <controls:FANumberBox Grid.Row="0" Width="100"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Value="{Binding Settings.CountdownSeconds, Mode=TwoWay, Converter={x:Static ci:NotNaNConverter.Instance}}" />
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem Content="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.UseFuzzyCountdown}">
                        <controls:FASettingsExpanderItem.Footer>
                            <ToggleSwitch IsChecked="{Binding Settings.IsNonExactCountdownEnabled, Mode=TwoWay}"/>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                </controls:FASettingsExpander>

                <!-- 上课时仅显示当前课程 -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEFBF;}"
                                           Header="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Header.OnlyShowTheCurrentClassDuringClass}"
                                           Description="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Description.WhenInTheClassTypeOnlyTheCurrent}">
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.ShowCurrentLessonOnlyOnClass, Mode=TwoWay}"/>
                    </controls:FASettingsExpander.Footer>
                </controls:FASettingsExpander>

                <!-- 不显示已结束的课程 -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xEFBF;}"
                                           Header="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Header.CoursesThatHaveEndedAreNotDisplayed}"
                                           Description="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Description.HideCompletedCoursesOnlyTheCurrentCourseAnd}">
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.HideFinishedClass, Mode=TwoWay}"/>
                    </controls:FASettingsExpander.Footer>
                </controls:FASettingsExpander>

                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xF37D;}"
                                           Header="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Header.DownplayTheCoursesYouVeTaken}"
                                           Description="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Description.CoursesAlreadyAttendedWillBeFadedAndDisplayed}">
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.FadeCompletedClasses, Mode=TwoWay}"/>
                    </controls:FASettingsExpander.Footer>
                </controls:FASettingsExpander>

                <!-- 标记换课课程 -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE15F;}"
                                           Header="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Header.MarkTheTransferCourse}"
                                           Description="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Description.HighlightCoursesInTheTemporaryLayerOnlyCourses}">
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.HighlightChangedClass, Mode=TwoWay}"/>
                    </controls:FASettingsExpander.Footer>
                </controls:FASettingsExpander>

                <!-- 课程表文本间距 -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE0ED;}"
                                           Header="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Header.SpacingBetweenClassScheduleTexts}"
                                           Description="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Description.MakeTheTimetableAppearMoreCompactOrRelaxed}">
                    <controls:FASettingsExpander.Footer>
                        <Slider Width="150" Minimum="0.2" Maximum="1"
                                Value="{Binding Settings.ScheduleSpacing}"
                                TickFrequency="0.05" IsSnapToTickEnabled="True"/>
                    </controls:FASettingsExpander.Footer>
                </controls:FASettingsExpander>

                <!-- 无课程时显示占位符 -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE51C;}"
                                           Header="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Header.PlaceholdersAreDisplayedWhenThereAreNoClasses}"
                                           Description="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Description.DisplayTheSpecifiedPlaceholderWhenTheScheduleIs}"
                                           IsExpanded="{Binding Settings.ShowPlaceholderOnEmptyClassPlan, Mode=OneWay}">
                    <controls:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.ShowPlaceholderOnEmptyClassPlan, Mode=TwoWay}"/>
                    </controls:FASettingsExpander.Footer>
                    <controls:FASettingsExpanderItem Content="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.PlaceholderContentForDaysWithNoClasses}">
                        <controls:FASettingsExpanderItem.Footer>
                            <TextBox MinWidth="100"
                                     MaxWidth="300"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBody}"
                                     Text="{Binding Settings.PlaceholderTextNoClass, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <!-- <system:String>{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.ThereAreNoClassesToday}</system:String> -->
                                <!-- <system:String>{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.None}</system:String> -->
                                <!-- <system:String>[ ]</system:String> -->
                            </TextBox>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                    <controls:FASettingsExpanderItem Content="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.PlaceholderContentForDaysAfterClassesEnd}">
                        <controls:FASettingsExpanderItem.Footer>
                            <TextBox MinWidth="100"
                                     MaxWidth="300"
                                     Grid.Column="1"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource MaterialDesignBody}"
                                     Text="{Binding Settings.PlaceholderTextAllClassEnded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
                                <!-- <system:String>{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.ThereAreNoClassesToday}</system:String> -->
                                <!-- <system:String>{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.None}</system:String> -->
                                <!-- <system:String>[ ]</system:String> -->
                            </TextBox>
                        </controls:FASettingsExpanderItem.Footer>
                    </controls:FASettingsExpanderItem>
                </controls:FASettingsExpander>

                <!-- 放学后显示明天课表 -->
                <controls:FASettingsExpander IconSource="{ci:FluentIconSource &#xE34A;}"
                                           Header="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Header.DisplaysTomorrowSClassSchedule}"
                                           Description="{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Description.SetWhenTomorrowSScheduleWillBeDisplayed}">
                    <controls:FASettingsExpander.Footer>
                        <Grid>
                            <ComboBox SelectedIndex="{Binding Settings.TomorrowScheduleShowMode}">
                                <ComboBoxItem>{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.NotDisplayed}</ComboBoxItem>
                                <ComboBoxItem>{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.DisplayedAfterSchool}</ComboBoxItem>
                                <ComboBoxItem>{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.AlwaysShows}</ComboBoxItem>
                                <ComboBoxItem>{ci:Tr Controls.Components.ScheduleComponentSettingsControl.Content.DisplayedWhenNoCourseIsShown}</ComboBoxItem>
                            </ComboBox>
                        </Grid>
                    </controls:FASettingsExpander.Footer>
                </controls:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ci:ComponentBase>
