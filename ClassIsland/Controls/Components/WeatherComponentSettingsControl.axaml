<controls:ComponentBase x:TypeArguments="componentSettings:WeatherComponentSettings"
                        x:Class="ClassIsland.Controls.Components.WeatherComponentSettingsControl"
                        xmlns="https://github.com/avaloniaui"
                        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                        xmlns:local="clr-namespace:ClassIsland.Controls.Components"
                        xmlns:controls="clr-namespace:ClassIsland.Core.Abstractions.Controls;assembly=ClassIsland.Core"
                        xmlns:componentSettings="clr-namespace:ClassIsland.Models.ComponentSettings"
                        xmlns:ci="http://classisland.tech/schemas/xaml/core"
                        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
                        xmlns:controls1="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
                        mc:Ignorable="d"
                        d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:WeatherComponentSettingsControl}}">
        <StackPanel Classes="component-settings-container animated-intro" Margin="0">
                <controls1:FAInfoBar Message="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Message.ThisPageOnlyContainsComponentSettingsToAdjust}"
                                   IsOpen="True" IsClosable="False"/>

                <controls1:FASettingsExpander IconSource="{ci:FluentIconSource &#xEFD7;}"
                                            Header="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Header.DisplaysWeatherInformation}"
                                            Description="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Description.DisplaysASummaryOfCurrentWeatherInformation}">
                    <controls1:FASettingsExpander.Footer>
                        <StackPanel Orientation="Horizontal" Spacing="4"
                                    Classes="items-valign-center">
                            <ComboBox SelectedIndex="{Binding Settings.MainWeatherInfoKind}"
                                      IsVisible="{Binding Settings.ShowMainWeatherInfo}"
                                      MinWidth="110">
                                <ComboBoxItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.WeatherTypeTemperature}"/>
                                <ComboBoxItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.Humidity}"/>
                                <ComboBoxItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.WindPower}"/>
                                <ComboBoxItem>AQI</ComboBoxItem>
                                <ComboBoxItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.AirPressure}"/>
                                <ComboBoxItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.PerceivedTemperature}"/>
                            </ComboBox>
                            <ToggleSwitch IsChecked="{Binding Settings.ShowMainWeatherInfo}"/>
                        </StackPanel>
                    </controls1:FASettingsExpander.Footer>
                </controls1:FASettingsExpander>

                <controls1:FASettingsExpander IconSource="{ci:FluentIconSource &#xF431;}"
                                            Header="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Header.DisplayWarningSignals}"
                                            Description="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Description.OnceEnabledAlertsWillAppearAsIconsOn}"
                                            IsExpanded="{Binding Settings.ShowAlerts, Mode=OneWay}">
                    <controls1:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.ShowAlerts, Mode=TwoWay}"/>
                    </controls1:FASettingsExpander.Footer>
                    <controls1:FASettingsExpanderItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.DisplaysTheWarningType}"
                                                    IconSource="{ci:FluentIconSource &#xF21A;}"
                                                    Description="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Description.SetTheWarningTypeUnderWhatCircumstancesIt}">
                        <controls1:FASettingsExpanderItem.Footer>
                            <ComboBox SelectedIndex="{Binding Settings.AlertsTitleShowMode}">
                                <ComboBoxItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.NotDisplayed}"/>
                                <ComboBoxItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.OnlyWhenThereIsNoCorrespondingIcon}"/>
                                <ComboBoxItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.AlwaysShows}"/>
                            </ComboBox>
                        </controls1:FASettingsExpanderItem.Footer>
                    </controls1:FASettingsExpanderItem>
                </controls1:FASettingsExpander>

                <controls1:FASettingsExpander IconSource="{ci:FluentIconSource &#xF453;}"
                                            Header="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Header.DisplaysPrecipitationAlerts}"
                                            Description="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Description.OnceEnabledTheExpectedPrecipitationTimeAndRemaining}"
                                            IsExpanded="{Binding Settings.ShowRainTime, Mode=OneWay}">
                    <controls1:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.ShowRainTime, Mode=TwoWay}"/>
                    </controls1:FASettingsExpander.Footer>
                    <controls1:FASettingsExpanderItem Content="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Content.BlurredLongDurationRainfallCountdownTimeDisplayAccuracy}"
                                                    Description="{ci:Tr Controls.Components.WeatherComponentSettingsControl.Description.WhenEnabledRainfallTimesLongerThan60Minutes}">
                        <controls1:FASettingsExpanderItem.IsVisible>
                            <Binding Path="Settings.ShowRainTime"/>
                        </controls1:FASettingsExpanderItem.IsVisible>
                        <controls1:FASettingsExpanderItem.Footer>
                            <ToggleSwitch IsChecked="{Binding Settings.IsFuzzyLongRainCountdownEnabled, Mode=TwoWay}"/>
                        </controls1:FASettingsExpanderItem.Footer>
                    </controls1:FASettingsExpanderItem>
                </controls1:FASettingsExpander>
        </StackPanel>
    </ScrollViewer>
</controls:ComponentBase>
