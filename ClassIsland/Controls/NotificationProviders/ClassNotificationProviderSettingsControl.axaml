<ci:NotificationProviderControlBase x:Class="ClassIsland.Controls.NotificationProviders.ClassNotificationProviderSettingsControl"
             x:TypeArguments="notificationProviderSettings:ClassNotificationSettings"
             xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:ClassIsland.Controls.NotificationProviders"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:controls="clr-namespace:ClassIsland.Controls"
             xmlns:converters="clr-namespace:ClassIsland.Converters"
             xmlns:converters1="clr-namespace:ClassIsland.Core.Converters;assembly=ClassIsland.Core"
             xmlns:controls1="clr-namespace:ClassIsland.Core.Controls;assembly=ClassIsland.Core"
             xmlns:ci="http://classisland.tech/schemas/xaml/core"
             xmlns:notificationProviderSettings="clr-namespace:ClassIsland.Models.NotificationProviderSettings"
             xmlns:controls2="clr-namespace:FluentAvalonia.UI.Controls;assembly=FluentAvalonia"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <converters1:IntToStringConverter x:Key="IntToStringConverter" />
    </UserControl.Resources>
    <Grid DataContext="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType=local:ClassNotificationProviderSettingsControl}}">
        <ScrollViewer>
            <StackPanel Classes="settings-container animated-intro"
                        Margin="0">
                <!-- 附加设置覆盖提示 -->
                <controls2:FAInfoBar Message="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Message.TheSettingsHereCanBeOverwrittenByThe}"
                                   IsOpen="True" IsClosable="False">
                    <controls2:FAInfoBar.ActionButton>
                        <Button Click="ButtonShowAttachedSettingsInfo_OnClick"
                                Content="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Content.View}"/>
                    </controls2:FAInfoBar.ActionButton>
                </controls2:FAInfoBar>

                <!-- 在课前准备时发出提醒 -->
                <controls2:FASettingsExpander IconSource="{ci:FluentIconSource &#xe21b;}"
                                            Header="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Header.GiveRemindersDuringPreClassPreparation}"
                                            Description="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Description.IssueProminentRemindersBeforeClassToPromptStudents}"
                                            IsExpanded="{Binding Settings.IsClassOnPreparingNotificationEnabled, Mode=OneWay}">
                    <controls2:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsClassOnPreparingNotificationEnabled, Mode=TwoWay}"/>
                    </controls2:FASettingsExpander.Footer>
                    <!-- 启用语音 -->
                    <controls2:FASettingsExpanderItem>
                        <CheckBox Content="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Content.EnableVoice}"
                                  IsChecked="{Binding Settings.IsSpeechEnabledOnClassPreparing}"/>
                    </controls2:FASettingsExpanderItem>
                    <!-- 室内课程课前提醒时间 -->
                    <controls2:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe02b;}"
                                                    Content="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Content.IndoorCoursePreClassReminderTime}"
                                                    Description="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Description.DesignatedTimeRemindersForClassesBeforeIndoorClasses}">
                        <controls2:FASettingsExpanderItem.Footer>
                            <controls1:Field Suffix="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Suffix.Seconds}">
                                <controls2:FANumberBox Maximum="3600" Minimum="0"
                                                     Value="{Binding Settings.InDoorClassPreparingDeltaTime, Converter={x:Static ci:NotNaNConverter.Instance}}"
                                                     Width="150"
                                                     SpinButtonPlacementMode="Inline"/>
                            </controls1:Field>
                        </controls2:FASettingsExpanderItem.Footer>
                    </controls2:FASettingsExpanderItem>
                    <!-- 室外课程课前提醒时间 -->
                    <controls2:FASettingsExpanderItem IconSource="{ci:FluentIconSource &#xe02b;}"
                                                    Content="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Content.OutdoorClassesReminderTimeBeforeClass}"
                                                    Description="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Description.SetADesignatedTimeForClassRemindersBefore}">
                        <controls2:FASettingsExpanderItem.Footer>
                            <controls1:Field Suffix="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Suffix.Seconds}">
                                <controls2:FANumberBox Maximum="3600" Minimum="0"
                                                     Value="{Binding Settings.OutDoorClassPreparingDeltaTime, Converter={x:Static ci:NotNaNConverter.Instance}}"
                                                     Width="150"
                                                     SpinButtonPlacementMode="Inline"/>
                            </controls1:Field>
                        </controls2:FASettingsExpanderItem.Footer>
                    </controls2:FASettingsExpanderItem>
                    <!-- 准备上课提醒文字 -->
                    <controls2:FASettingsExpanderItem >
                        <ci:Field Label="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Label.IndoorClassPreparationReminderText}">
                            <TextBox Text="{Binding Settings.ClassOnPreparingText}"
                                     MinWidth="150"
                                     Watermark="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Watermark.Disabled}"/>
                        </ci:Field>
                    </controls2:FASettingsExpanderItem>
                    <!-- 准备上课遮罩文字 -->
                    <controls2:FASettingsExpanderItem>
                        <ci:Field Label="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Label.IndoorClassPreparationMaskText}">
                            <TextBox Text="{Binding Settings.ClassOnPreparingMaskText}"
                                     MinWidth="150"/>
                        </ci:Field>
                    </controls2:FASettingsExpanderItem>
                    <!-- 户外课程准备上课提醒文字 -->
                    <controls2:FASettingsExpanderItem>
                        <ci:Field Label="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Label.OutdoorClassPreparationReminderText}">
                            <TextBox Text="{Binding Settings.OutdoorClassOnPreparingText}"
                                     MinWidth="150"
                                     Watermark="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Watermark.Disabled}"/>
                        </ci:Field>
                    </controls2:FASettingsExpanderItem>
                    <!-- 户外课程准备上课遮罩文字 -->
                    <controls2:FASettingsExpanderItem>
                        <ci:Field Label="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Label.OutdoorClassPreparationMaskText}">
                            <TextBox Text="{Binding Settings.OutdoorClassOnPreparingMaskText}"/>
                        </ci:Field>
                    </controls2:FASettingsExpanderItem>
                </controls2:FASettingsExpander>

                <!-- 在上课时发出提醒 -->
                <controls2:FASettingsExpander IconSource="{ci:FluentIconSource &#xe47a;}"
                                            Header="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Header.SendRemindersDuringClass}"
                                            Description="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Description.IssueProminentRemindersDuringClassToIndicateThat}"
                                            IsExpanded="{Binding Settings.IsClassOnNotificationEnabled, Mode=OneWay}">
                    <controls2:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsClassOnNotificationEnabled, Mode=TwoWay}"/>
                    </controls2:FASettingsExpander.Footer>
                    <!-- 启用语音 -->
                    <controls2:FASettingsExpanderItem>
                        <CheckBox Content="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Content.EnableVoice}"
                                  IsChecked="{Binding Settings.IsSpeechEnabledOnClassOn}"/>
                    </controls2:FASettingsExpanderItem>
                    <!-- 上课遮罩文字 -->
                    <controls2:FASettingsExpanderItem>
                        <ci:Field Label="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Label.ClassMaskText}">
                            <TextBox Text="{Binding Settings.ClassOnMaskText}"
                                     MinWidth="150"/>
                        </ci:Field>
                    </controls2:FASettingsExpanderItem>
                </controls2:FASettingsExpander>

                <!-- 在下课时发出提醒 -->
                <controls2:FASettingsExpander IconSource="{ci:FluentIconSource &#xe4c4;}"
                                            Header="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Header.GiveRemindersAfterClass}"
                                            Description="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Description.IssueAProminentReminderAtTheEndOf}"
                                            IsExpanded="{Binding Settings.IsClassOffNotificationEnabled, Mode=OneWay}">
                    <controls2:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.IsClassOffNotificationEnabled, Mode=TwoWay}"/>
                    </controls2:FASettingsExpander.Footer>
                    <!-- 启用语音 -->
                    <controls2:FASettingsExpanderItem>
                        <CheckBox Content="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Content.EnableVoice}"
                                  IsChecked="{Binding Settings.IsSpeechEnabledOnClassOff}"/>
                    </controls2:FASettingsExpanderItem>
                    <!-- 下课提醒文字 -->
                    <controls2:FASettingsExpanderItem>
                        <ci:Field Label="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Label.ClassEndReminderText}">
                            <TextBox Text="{Binding Settings.ClassOffOverlayText}"
                                     MinWidth="150"
                                     Watermark="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Watermark.Disabled}"/>
                        </ci:Field>
                    </controls2:FASettingsExpanderItem>
                </controls2:FASettingsExpander>

                <!-- 显示教科任老师名字 -->
                <controls2:FASettingsExpander IconSource="{ci:FluentIconSource &#xeee9;}"
                                            Header="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Header.DisplayTheNameOfTheSubjectTeacher}"
                                            Description="{ci:Tr Controls.NotificationProviders.ClassNotificationProviderSettingsControl.Description.WhenCourseRemindersAreDisplayedTheNameOf}">
                    <controls2:FASettingsExpander.Footer>
                        <ToggleSwitch IsChecked="{Binding Settings.ShowTeacherName, Mode=TwoWay}"/>
                    </controls2:FASettingsExpander.Footer>
                </controls2:FASettingsExpander>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</ci:NotificationProviderControlBase>
